<%- include('partials/header') %>

<div class="row mt-4 mb-4">
    <div class="col-md-12">
        <div class="card shadow-sm border-0 rounded-4 p-4 text-white" style="background: linear-gradient(135deg, #0d9488 0%, #115e59 100%);">
            <h1 class="fw-bold mb-1">
                <i class="bi bi-calendar-event me-2"></i>
                <%= __('Apply_Leave') || 'رخصت کی درخواست' %>
            </h1>
            <p class="text-teal-100 mb-0">
                <%= __('Apply_Leave_Sub') || 'یہاں سے آپ اپنی رخصت کی درخواست دے سکتے ہیں۔' %>
            </p>
        </div>
    </div>
</div>

<div class="row">
    <!-- Leave Application Form -->
    <div class="col-md-4 mb-4">
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-header bg-white p-4 border-0">
                <h5 class="fw-bold text-dark mb-0"><%= __('New_Leave_Request') || 'نئی درخواست' %></h5>
            </div>
            <div class="card-body p-4 pt-0">
                <form action="/student/leaves/apply" method="POST">
                    <div class="mb-3">
                        <label class="form-label text-muted small"><%= __('Start_Date') || 'شروع کی تاریخ' %></label>
                        <input type="date" name="start_date" class="form-control rounded-3" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-muted small"><%= __('End_Date') || 'ختم کی تاریخ' %></label>
                        <input type="date" name="end_date" class="form-control rounded-3" required>
                    </div>
                    <div class="mb-4">
                        <label class="form-label text-muted small"><%= __('Reason') || 'وجہ' %></label>
                        <textarea name="reason" class="form-control rounded-3" rows="3" required></textarea>
                    </div>
                    <button type="submit" class="btn btn-teal rounded-pill w-100 py-2 fw-bold">
                        <i class="bi bi-send me-1"></i><%= __('Submit') || 'جمع کروائیں' %>
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- Leave History -->
    <div class="col-md-8">
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-header bg-white p-4 border-0">
                <h5 class="fw-bold text-dark mb-0"><i class="bi bi-clock-history me-2"></i><%= __('Leave_History') || 'رخصت کا ریکارڈ' %></h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="p-3"><%= __('Start_Date') || 'شروع کی تاریخ' %></th>
                                <th class="p-3"><%= __('End_Date') || 'ختم کی تاریخ' %></th>
                                <th class="p-3"><%= __('Reason') || 'وجہ' %></th>
                                <th class="p-3"><%= __('Status') || 'حالت' %></th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (leaves.length === 0) { %>
                                <tr>
                                    <td colspan="4" class="text-center py-4 text-muted"><%= __('No_Records') || 'کوئی ریکارڈ نہیں' %></td>
                                </tr>
                            <% } else { %>
                                <% leaves.forEach(leave => { %>
                                    <tr>
                                        <td class="p-3"><%= new Date(leave.start_date).toLocaleDateString('ur-PK') %></td>
                                        <td class="p-3"><%= new Date(leave.end_date).toLocaleDateString('ur-PK') %></td>
                                        <td class="p-3 text-truncate" style="max-width: 150px;"><%= leave.reason %></td>
                                        <td class="p-3">
                                            <% if (leave.status === 'pending') { %>
                                                <span class="badge bg-warning text-dark px-3 py-2 rounded-pill"><%= __('Pending') || 'زیر التواء' %></span>
                                            <% } else if (leave.status === 'approved') { %>
                                                <span class="badge bg-success px-3 py-2 rounded-pill"><%= __('Approved') || 'منظور شدہ' %></span>
                                            <% } else { %>
                                                <span class="badge bg-danger px-3 py-2 rounded-pill"><%= __('Rejected') || 'مسترد شدہ' %></span>
                                            <% } %>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .btn-teal {
        background-color: #0d9488 !important;
        border-color: #0d9488 !important;
        color: white !important;
    }
    .btn-teal:hover {
        background-color: #0f766e !important;
        border-color: #0f766e !important;
    }
</style>

<%- include('partials/footer') %>
