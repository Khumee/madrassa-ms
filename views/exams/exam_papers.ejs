<%- include('../partials/header', { title: __('All_Papers') || 'All Papers' }) %>

<div class="container mt-1 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1"><%= __('All_Papers') || 'All Papers' %></h2>
            <p class="text-muted mb-0"><%= exam.name %></p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#assignPaperModal">
                <i class="bi bi-plus-lg me-1"></i> <%= __('Assign_New_Paper') || 'Assign New Paper' %>
            </button>
            <a href="/exams" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> <%= __('Back_to_Exams') || 'امتحانات پر واپس جائیں' %>
            </a>
        </div>
    </div>

    <!-- Expandable Filter Chips -->
    <div class="card shadow-sm border-0 rounded-4 mb-4" style="background: rgba(255, 255, 255, 0.9); backdrop-filter: blur(10px);">
        <div class="card-body p-3">
            <div class="row g-3">
                
                <!-- Class Filters -->
                <div class="col-md-6">
                    <small class="text-muted d-block mb-2 fw-bold"><i class="bi bi-building me-1"></i><%= __('Filter_By_Class') || 'Filter By Class' %></small>
                    <div class="d-flex flex-wrap gap-2">
                        <button class="btn btn-sm <%= !selectedClassId ? 'btn-primary' : 'btn-outline-primary' %> rounded-pill px-3" onclick="filterPapers('classId', '')"><%= __('All') %></button>
                        <% classes.forEach(cls => { %>
                            <% const isSelected = selectedClassId == cls.id; %>
                            <button class="btn btn-sm <%= isSelected ? 'btn-primary active' : 'btn-outline-primary' %> rounded-pill px-3" onclick="filterPapers('classId', '<%= cls.id %>')"><%= cls.name_ar %></button>
                        <% }) %>
                    </div>
                </div>

                <!-- Teacher Filters -->
                <div class="col-md-6">
                    <small class="text-muted d-block mb-2 fw-bold"><i class="bi bi-person-badge me-1"></i><%= __('Filter_By_Teacher') || 'Filter By Teacher' %></small>
                    <div class="d-flex flex-wrap gap-2">
                        <button class="btn btn-sm <%= !selectedTeacherId ? 'btn-dark' : 'btn-outline-dark' %> rounded-pill px-3" onclick="filterPapers('teacherId', '')"><%= __('All') %></button>
                        <% teachers.forEach((t, i) => { %>
                            <% 
                                const isSelected = selectedTeacherId == t.id;
                                const colors = ['success', 'info', 'warning', 'danger', 'secondary'];
                                const color = colors[i % colors.length];
                            %>
                            <button class="btn btn-sm <%= isSelected ? 'btn-' + color + ' active' : 'btn-outline-' + color %> rounded-pill px-3" onclick="filterPapers('teacherId', '<%= t.id %>')"><%= t.name %></button>
                        <% }) %>
                    </div>
                </div>
                
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="px-4 py-3"><%= __('Class') %></th>
                            <th class="px-4 py-3"><%= __('Subject') %></th>
                            <th class="px-4 py-3"><%= __('Teacher') %></th>
                            <th class="px-4 py-3 text-center"><%= __('Total_Marks') || __('Max_Marks') %></th>
                            <th class="px-4 py-3 text-center"><%= __('Date') || 'Date' %></th>
                            <th class="px-4 py-3 text-end"><%= __('Actions') %></th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (papers && papers.length > 0) { %>
                            <% papers.forEach(p => { %>
                                <tr>
                                    <td class="px-4 align-middle fw-semibold text-primary"><%= p.class_name %></td>
                                    <td class="px-4 align-middle"><%= p.subject %></td>
                                    <td class="px-4 align-middle"><%= p.teacher_name %></td>
                                    <td class="px-4 align-middle text-center"><%= p.max_marks %></td>
                                    <td class="px-4 align-middle text-center">
                                        <% if (p.paper_date) { %>
                                            <%= new Date(p.paper_date).toLocaleDateString('ur-PK') %>
                                        <% } else { %>
                                            <span class="text-muted small"><%= __('Not_set') || 'درج نہیں' %></span>
                                        <% } %>
                                        <button class="btn btn-sm btn-link text-decoration-none ms-2 p-0" onclick="openDateModal('<%= p.id %>', '<%= p.paper_date ? new Date(p.paper_date - (new Date(p.paper_date).getTimezoneOffset() * 60000)).toISOString().split('T')[0] : '' %>')" title="Edit Date"><i class="bi bi-pencil-square text-secondary"></i></button>
                                    </td>
                                    <td class="px-4 align-middle text-end">
                                        <a href="/papers/<%= p.id %>/view" class="btn btn-sm btn-outline-primary rounded-pill px-3"><i class="bi bi-eye me-1"></i><%= __('View_Paper') || 'View Paper' %></a>
                                        <a href="/papers/<%= p.id %>/view?print=true" class="btn btn-sm btn-outline-success rounded-pill px-3 ms-1"><i class="bi bi-printer me-1"></i>پرنٹ کریں</a>
                                        <a href="/papers/<%= p.id %>/enter-marks" class="btn btn-sm btn-outline-warning rounded-pill px-3 ms-1"><i class="bi bi-pencil-square me-1"></i>نمبرات درج کریں</a>
                                        <form action="/papers/<%= p.id %>/delete" method="POST" onsubmit="event.preventDefault(); const form = this; showConfirm('<%= __('Are_you_sure_you_want_to_delete_this_paper') || "کیا آپ واقعی اس پرچے کو حذف کرنا چاہتے ہیں؟" %>').then(c => { if(c) form.submit(); });" style="display:inline-block;">
                                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3 ms-1"><i class="bi bi-trash me-1"></i><%= __('Delete') || 'حذف کریں' %></button>
                                        </form>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    <i class="bi bi-inbox fs-1 d-block mb-3"></i>
                                    <%= __('No_papers_found') || 'No papers found' %>
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Update Date Modal -->
<div class="modal fade" id="updateDateModal" tabindex="-1">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <form id="updateDateForm" method="POST">
                <div class="modal-header">
                    <h5 class="modal-title"><%= __('Update_Paper_Date') || 'تاریخ اپ ڈیٹ کریں' %></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label"><%= __('Date') || 'تاریخ' %></label>
                        <input type="date" name="paper_date" id="modalPaperDate" class="form-control">
                    </div>
                </div>
                <div class="modal-footer flex-nowrap">
                    <button type="submit" class="btn btn-primary"><%= __('Save') || 'محفوظ کریں' %></button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><%= __('Cancel') || 'منسوخ کریں' %></button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Assign Paper Modal -->
<div class="modal fade" id="assignPaperModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form action="/exams/<%= exam.id %>/assign" method="POST">
                <div class="modal-header">
                    <h5 class="modal-title"><%= __('Assign_New_Paper') || 'Assign New Paper' %></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label"><%= __('Class') %></label>
                        <select name="class_id" id="assignClassSelect" class="form-select" required>
                            <option value=""><%= __('Select_Class') %></option>
                            <% allClasses.forEach(c => { %>
                                <option value="<%= c.id %>"><%= c.name_ar %> - <%= c.name_en %></option>
                            <% }) %>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label"><%= __('Subject') %></label>
                        <select name="subject" id="subjectSelect" class="form-select" required>
                            <option value=""><%= __('Select_Subject') || 'Select Subject' %></option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label"><%= __('Teacher') %></label>
                        <select name="teacher_id" class="form-select" required>
                            <option value=""><%= __('Select_Teacher') %></option>
                            <% allTeachers.forEach(t => { %>
                                <option value="<%= t.id %>"><%= t.username %></option>
                            <% }) %>
                        </select>
                    </div>
                    <div class="form-text mb-3">
                        <%= __('Total_Marks_Auto_Note') || 'Total marks are calculated automatically from the questions you add to the paper.' %>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary"><%= __('Assign_Paper') || 'Assign Paper' %></button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function openDateModal(paperId, currentDate) {
        document.getElementById('updateDateForm').action = '/papers/' + paperId + '/update-date';
        if (!currentDate) {
            const today = new Date();
            currentDate = new Date(today.getTime() - (today.getTimezoneOffset() * 60000)).toISOString().split('T')[0];
        }
        document.getElementById('modalPaperDate').value = currentDate;
        new bootstrap.Modal(document.getElementById('updateDateModal')).show();
    }

    document.addEventListener('DOMContentLoaded', function() {
        const books = <%- JSON.stringify(books || []) %>;
        const classSelect = document.getElementById('assignClassSelect');
        const subjectSelect = document.getElementById('subjectSelect');

        if (classSelect && subjectSelect) {
            classSelect.addEventListener('change', function() {
                const classId = this.value;
                subjectSelect.innerHTML = '<option value=""><%= __('Select_Subject') || 'Select Subject' %></option>';
                if (classId) {
                    const classBooks = books.filter(b => b.class_id == classId);
                    classBooks.forEach(b => {
                        const opt = document.createElement('option');
                        opt.value = b.title;
                        opt.textContent = b.title;
                        subjectSelect.appendChild(opt);
                    });
                }
            });
        }
    });

    function filterPapers(type, value) {
        const urlParams = new URLSearchParams(window.location.search);
        
        if (value === '') {
            urlParams.delete(type);
        } else {
            // Toggle logic: if clicking the already selected value, remove the filter
            if (urlParams.get(type) === value) {
                urlParams.delete(type);
            } else {
                urlParams.set(type, value);
            }
        }
        
        window.location.href = window.location.pathname + (urlParams.toString() ? '?' + urlParams.toString() : '');
    }
</script>

<%- include('../partials/footer') %>
