<%- include('../partials/header', { title: __('Exam_Result_Gazette') || 'Exam Result Gazette & Merit Summary' }) %>

<style>
    @media print {
        .no-print, nav, #toastContainer, footer, .btn, .btn-group, .filter-trigger-btn { display: none !important; }
        body {
            background: white !important;
            margin: 0 !important;
            padding: 1cm !important;
            font-family: 'Jameel Noori Nastaleeq', 'Nafees Web Naskh', 'Amiri', 'Tahoma', 'Arial', sans-serif !important;
            color: #111 !important;
        }
        .container { max-width: 100% !important; width: 100% !important; padding: 0 !important; margin: 0 !important; }
        .card { border: none !important; box-shadow: none !important; }
        .print-header { display: flex !important; }
        .print-table {
            border-collapse: collapse !important;
            width: 100% !important;
        }
        .print-table th, .print-table td {
            border: 1px solid #333 !important;
            padding: 6px 8px !important;
            font-size: 0.95rem !important;
        }
        .print-table th {
            background-color: #f0f0f0 !important;
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
        }
        .print-sign-block {
            display: flex !important;
            page-break-inside: avoid;
        }
        .print-kpis {
            display: block !important;
        }
        .podium-section {
            page-break-inside: avoid;
        }
        .badge {
            border: 1px solid #333 !important;
            color: #000 !important;
            background: transparent !important;
        }
    }

    .print-header, .print-sign-block, .print-kpis { display: none; }

    .podium-card {
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        border: 2px solid transparent;
        position: relative;
        overflow: hidden;
    }
    .podium-card:hover {
        transform: translateY(-4px);
    }
    .podium-1 {
        border-color: #f59e0b !important;
        background: linear-gradient(145deg, #fffbeb 0%, #ffffff 100%);
        box-shadow: 0 10px 25px -5px rgba(245, 158, 11, 0.2);
    }
    .podium-2 {
        border-color: #94a3b8 !important;
        background: linear-gradient(145deg, #f8fafc 0%, #ffffff 100%);
        box-shadow: 0 8px 20px -5px rgba(148, 163, 184, 0.2);
    }
    .podium-3 {
        border-color: #d97706 !important;
        background: linear-gradient(145deg, #fff7ed 0%, #ffffff 100%);
        box-shadow: 0 8px 20px -5px rgba(217, 119, 6, 0.15);
    }
    .medal-icon {
        font-size: 2.2rem;
        line-height: 1;
    }
</style>

<!-- Print Only Header -->
<div class="print-header flex-column align-items-center justify-content-center text-center mb-4 pb-3 border-bottom border-2 border-dark">
    <div class="d-flex align-items-center justify-content-center gap-3 mb-2">
        <img src="<%= locals.tenant && tenant.logo_url ? tenant.logo_url : '/logo.jpg' %>" alt="Logo" style="width: 70px; height: 70px; object-fit: contain; border-radius: 50%;">
        <div>
            <h2 class="fw-bold mb-0 text-dark"><%= locals.tenant ? (tenant.subdomain === 'madrassa-ms' ? __('Jamia_Habibullah_Islamabad') : (tenant.subdomain === 'kui' ? __('KUI_Production') : tenant.school_name)) : __('College_Name') %></h2>
            <h4 class="fw-bold text-secondary mb-0"><%= exam.name %></h4>
        </div>
    </div>
    <div class="d-flex justify-content-between align-items-center w-100 px-4 mt-2 font-monospace fs-6">
        <span><strong><%= __('Exam_Result_Gazette') || 'امتحانی گزٹ / میرٹ لسٹ' %></strong></span>
        <span><%= selectedClassId ? (classes.find(c => String(c.id) === String(selectedClassId)) ? classes.find(c => String(c.id) === String(selectedClassId)).name_ar : '') : (__('All') || 'تمام درجات') %></span>
        <span><%= __('Date') %>: <strong><%= new Date().toLocaleDateString(locals.lang === 'en' ? 'en-US' : 'ur-PK') %></strong></span>
    </div>
</div>

<!-- Print-Only KPI Summary Strip (For PDF & Print Export Only) -->
<div class="print-kpis w-100 mb-3 p-2 border border-dark rounded bg-light" style="page-break-inside: avoid;">
    <div class="d-flex justify-content-around text-center fw-bold fs-6">
        <div><span><%= __('Total_Students') || 'کل طلباء' %>:</span> <span class="badge text-dark border-0 p-0 fs-6"><%= stats.total %></span></div>
        <div><span><%= __('Passed_Students') || 'کامیاب طلباء' %>:</span> <span class="badge text-dark border-0 p-0 fs-6"><%= stats.passed %></span></div>
        <div><span><%= __('Failed_Students') || 'راسب طلباء' %>:</span> <span class="badge text-dark border-0 p-0 fs-6"><%= stats.failed %></span></div>
        <div><span><%= __('Pass_Percentage') || 'کامیابی کا تناسب' %>:</span> <span class="badge text-dark border-0 p-0 fs-6"><%= stats.passPercentage %>%</span></div>
    </div>
</div>

<div class="container mt-2 mb-5">
    <!-- Screen Header & Actions -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3 no-print">
        <div>
            <h2 class="fw-bold mb-1 text-primary">
                <i class="bi bi-trophy-fill text-warning me-2"></i><%= __('Exam_Result_Gazette') || 'امتحانی نتائج کا گزٹ / میرٹ لسٹ' %>
            </h2>
            <p class="text-muted mb-0"><%= exam.name %> &bull; <%= __('Generate_individual_report_cards_for_students') || 'مکمل امتحانی سمری، پوزیشنیں اور رزلٹ گزٹ' %></p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <a href="/exams/<%= exam.id %>/results/pdf<%= selectedClassId ? '?classId=' + selectedClassId : '' %>" onclick="if (typeof showPdfLoader === 'function') showPdfLoader();" class="btn btn-danger rounded-pill px-4 shadow-sm fw-bold">
                <i class="bi bi-file-earmark-pdf-fill me-1"></i> <%= __('Download_PDF') || 'پی ڈی ایف ڈاؤن لوڈ کریں' %>
            </a>
            <button onclick="window.print()" class="btn btn-outline-dark rounded-pill px-3 shadow-sm fw-bold">
                <i class="bi bi-printer me-1"></i> <%= __('Print') || 'پرنٹ' %>
            </button>
            <a href="/exams" class="btn btn-outline-secondary rounded-pill px-3 shadow-sm fw-bold">
                <i class="bi bi-arrow-left me-1"></i> <%= __('Back') || 'واپس' %>
            </a>
        </div>
    </div>

    <!-- Top 3 Position Holders (لوحِ شرف / Top Performers) -->
    <% if (topPositions && topPositions.length > 0) { %>
        <div class="podium-section card shadow-sm border-0 rounded-4 mb-4 bg-white overflow-hidden">
            <div class="card-header bg-gradient bg-light p-3 border-0 d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-2">
                    <span class="fs-4">🏆</span>
                    <h5 class="fw-bold mb-0 text-dark">
                        <%= __('Position_Holders') || 'نمایاں پوزیشن ہولڈرز (لوحِ شرف)' %>
                        <span class="badge bg-warning text-dark ms-2 fw-normal fs-6">
                            <%= selectedClassId ? (classes.find(c => String(c.id) === String(selectedClassId)) ? classes.find(c => String(c.id) === String(selectedClassId)).name_ar : '') : (__('Overall_Rank') || 'مجموعی رینکنگ') %>
                        </span>
                    </h5>
                </div>
            </div>
            <div class="card-body p-3 p-md-4">
                <div class="row g-3 align-items-end justify-content-center">
                    <% 
                        // Order for podium visually: 2nd on left, 1st in center, 3rd on right
                        const podiumOrder = [];
                        if (topPositions[1]) podiumOrder.push({ student: topPositions[1], rank: 2, cls: 'podium-2', medal: '🥈', title: __('Second_Position') || 'دوسری پوزیشن (دوم)' });
                        if (topPositions[0]) podiumOrder.push({ student: topPositions[0], rank: 1, cls: 'podium-1', medal: '🥇', title: __('First_Position') || 'پہلی پوزیشن (اول)' });
                        if (topPositions[2]) podiumOrder.push({ student: topPositions[2], rank: 3, cls: 'podium-3', medal: '🥉', title: __('Third_Position') || 'تیسری پوزیشن (سوم)' });
                    %>
                    <% podiumOrder.forEach(p => { %>
                        <div class="col-md-4 col-12">
                            <div class="card rounded-4 p-3 text-center podium-card <%= p.cls %>">
                                <div class="medal-icon mb-1"><%= p.medal %></div>
                                <span class="badge bg-dark text-white rounded-pill px-3 py-1 mx-auto mb-2 fw-bold" style="font-size: 0.8rem;">
                                    <%= p.title %>
                                </span>
                                <h5 class="fw-bold text-dark mb-1"><%= p.student.name %></h5>
                                <div class="text-muted small mb-2">
                                    <span class="badge bg-light text-dark border me-1"><%= __('Roll_Number') %>: <%= p.student.roll_number %></span>
                                    <span class="badge bg-light text-primary border"><%= p.student.class_name %></span>
                                </div>
                                <div class="p-2 rounded-3 bg-white bg-opacity-75 border d-flex justify-content-around align-items-center">
                                    <div>
                                        <small class="text-muted d-block" style="font-size: 0.72rem;"><%= __('Obtained_Marks') %></small>
                                        <strong class="text-dark fs-6"><%= p.student.totalObtained %> / <%= p.student.totalMax %></strong>
                                    </div>
                                    <div class="border-start ps-3">
                                        <small class="text-muted d-block" style="font-size: 0.72rem;"><%= __('Percentage') %></small>
                                        <strong class="text-primary fs-5"><%= p.student.percentage %>%</strong>
                                    </div>
                                    <div class="border-start ps-3">
                                        <small class="text-muted d-block" style="font-size: 0.72rem;"><%= __('Grade') %></small>
                                        <span class="badge bg-<%= p.student.gradeClass %> text-white"><%= p.student.gradeKey ? __(p.student.gradeKey) : '-' %></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                </div>
            </div>
        </div>
    <% } %>

    <!-- Expandable Class Filter Chips -->
    <div class="card shadow-sm border-0 rounded-4 mb-4 bg-white no-print">
        <div class="card-body p-3">
            <small class="text-muted d-block mb-2 fw-bold">
                <i class="bi bi-filter me-1"></i><%= __('Filter_By_Class') || 'درجہ کے لحاظ سے فلٹر کریں' %>
            </small>
            <div class="d-flex flex-wrap gap-2">
                <a href="/exams/<%= exam.id %>/results" class="btn btn-sm <%= !selectedClassId ? 'btn-primary active' : 'btn-outline-primary' %> rounded-pill px-3">
                    <i class="bi bi-grid-fill me-1"></i><%= __('All') || 'تمام درجات' %> (<%= allStudentsCount %>)
                </a>
                <% classes.forEach(c => { %>
                    <% const isSelected = selectedClassId == c.id; %>
                    <a href="/exams/<%= exam.id %>/results?classId=<%= c.id %>" class="btn btn-sm <%= isSelected ? 'btn-primary active' : 'btn-outline-primary' %> rounded-pill px-3">
                        <%= c.name_ar %>
                    </a>
                <% }) %>
            </div>
        </div>
    </div>
    
    <!-- Comprehensive Results Gazette Table -->
    <div class="card shadow-sm border-0 rounded-4 overflow-hidden bg-white">
        <div class="card-header bg-white p-3 border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2">
            <h5 class="fw-bold mb-0 text-dark">
                <i class="bi bi-table me-2 text-primary"></i><%= __('Results') %> (<%= students.length %> <%= __('Students') || 'طلباء' %>)
            </h5>
            <div class="small text-muted no-print">
                <span class="badge bg-success bg-opacity-10 text-success border border-success me-1">🥇 1st</span>
                <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary me-1">🥈 2nd</span>
                <span class="badge bg-warning bg-opacity-10 text-warning border border-warning">🥉 3rd</span>
            </div>
        </div>
        <div class="table-responsive">
            <table class="table table-hover table-striped align-middle mb-0 text-center print-table">
                <thead class="table-dark">
                    <tr>
                        <th style="width: 70px;"><%= __('Position') || 'پوزیشن' %></th>
                        <th><%= __('Roll_Number') %></th>
                        <th class="text-start px-3"><%= __('Name') %></th>
                        <th><%= __('Class') %></th>
                        <th><%= __('Total') %></th>
                        <th><%= __('Obtained_Marks') %></th>
                        <th><%= __('Percentage') %></th>
                        <th><%= __('Grade') %></th>
                        <th><%= __('Status') || 'کیفیت' %></th>
                        <th class="no-print"><%= __('Actions') || 'رپورٹ کارڈ' %></th>
                    </tr>
                </thead>
                <tbody>
                    <% if (typeof students !== 'undefined' && students.length > 0) { %>
                        <% students.forEach(s => { %>
                            <tr>
                                <!-- Position / Rank -->
                                <td class="align-middle">
                                    <% const rankToUse = selectedClassId ? s.classRank : (s.classRank || s.overallRank); %>
                                    <% if (s.allPapersUnmarked) { %>
                                        <span class="text-muted">-</span>
                                    <% } else if (rankToUse === 1) { %>
                                        <span class="badge bg-warning text-dark border border-warning fw-bold px-2 py-1 fs-6">🥇 1st</span>
                                    <% } else if (rankToUse === 2) { %>
                                        <span class="badge bg-secondary text-white border border-secondary fw-bold px-2 py-1 fs-6">🥈 2nd</span>
                                    <% } else if (rankToUse === 3) { %>
                                        <span class="badge bg-danger bg-opacity-10 text-danger border border-danger fw-bold px-2 py-1 fs-6">🥉 3rd</span>
                                    <% } else if (rankToUse) { %>
                                        <span class="badge bg-light text-dark border px-2 py-1 fw-bold"><%= rankToUse %></span>
                                    <% } else { %>
                                        <span class="text-muted">-</span>
                                    <% } %>
                                </td>

                                <!-- Roll Number -->
                                <td class="align-middle fw-semibold font-monospace"><%= s.roll_number || s.id %></td>

                                <!-- Student Name -->
                                <td class="align-middle text-start fw-bold px-3 text-dark">
                                    <a href="/exams/<%= exam.id %>/student/<%= s.id %>/report-card" class="text-decoration-none text-dark hover-underline">
                                        <%= s.name %>
                                    </a>
                                </td>

                                <!-- Class -->
                                <td class="align-middle">
                                    <span class="badge bg-light text-secondary border"><%= s.class_name %></span>
                                </td>

                                <!-- Max Marks -->
                                <td class="align-middle"><%= s.totalMax %></td>

                                <!-- Obtained Marks -->
                                <td class="align-middle fw-bold <%= s.status === 'fail' ? 'text-danger' : 'text-success' %>">
                                    <%= s.allPapersUnmarked ? '-' : (s.status === 'absent' ? __('Absent') || 'غائب' : s.totalObtained) %>
                                </td>

                                <!-- Percentage -->
                                <td class="align-middle">
                                    <% if (s.allPapersUnmarked || s.status === 'absent') { %>
                                        <span class="text-muted">-</span>
                                    <% } else { %>
                                        <div class="d-inline-flex align-items-center gap-1">
                                            <span class="fw-bold"><%= s.percentage %>%</span>
                                        </div>
                                    <% } %>
                                </td>

                                <!-- Grade -->
                                <td class="align-middle">
                                    <% if (s.allPapersUnmarked) { %>
                                        <span class="badge bg-light text-muted border">-</span>
                                    <% } else if (s.gradeKey) { %>
                                        <span class="badge bg-<%= s.gradeClass %> text-white px-2 py-1">
                                            <%= __(s.gradeKey) %>
                                        </span>
                                    <% } %>
                                </td>

                                <!-- Status -->
                                <td class="align-middle">
                                    <% if (s.status === 'pending') { %>
                                        <span class="badge bg-light text-muted border"><%= __('Pending') || 'زیر جائزہ' %></span>
                                    <% } else if (s.status === 'absent') { %>
                                        <span class="badge bg-secondary text-white"><%= __('Absent') || 'غیر حاضر' %></span>
                                    <% } else if (s.status === 'pass') { %>
                                        <span class="badge bg-success text-white px-2 py-1"><i class="bi bi-check-lg me-1"></i><%= __('Pass') || 'کامیاب' %></span>
                                    <% } else { %>
                                        <span class="badge bg-danger text-white px-2 py-1"><i class="bi bi-x-lg me-1"></i><%= __('Fail') || 'راسب' %></span>
                                    <% } %>
                                </td>

                                <!-- Action -->
                                <td class="align-middle no-print">
                                    <a href="/exams/<%= exam.id %>/student/<%= s.id %>/report-card" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                        <i class="bi bi-card-text me-1"></i> <%= __('View_Report_Card') %>
                                    </a>
                                </td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="10" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary"></i>
                                <%= __('No_students_found') || 'اس فلٹر کے تحت کوئی طالب علم نہیں ملا۔' %>
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Print Only Signatures Section -->
    <div class="print-sign-block row mt-5 pt-5 text-center">
        <div class="col-4">
            <hr style="width: 70%; margin: 0 auto 6px auto; border-top: 1.5px solid #000; opacity: 1;">
            <strong><%= __('Controller_Of_Exams') || 'ناظم امتحانات' %></strong>
        </div>
        <div class="col-4">
            <hr style="width: 70%; margin: 0 auto 6px auto; border-top: 1.5px solid #000; opacity: 1;">
            <strong><%= __('Class_Teacher') || 'انچارج کمیٹی' %></strong>
        </div>
        <div class="col-4">
            <hr style="width: 70%; margin: 0 auto 6px auto; border-top: 1.5px solid #000; opacity: 1;">
            <strong><%= __('Principal') || 'مہتمم / پرنسپل' %></strong>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>

