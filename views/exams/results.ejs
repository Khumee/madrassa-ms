<%- include('../partials/header', { title: __('Exam_Results') }) %>
<div class="container mt-1">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2><%= __('Exam_Results') %> - <%= exam.name %></h2>
            <p class="text-muted"><%= __('Generate_individual_report_cards_for_students') || 'Generate individual report cards for students.' %></p>
        </div>
        <a href="/exams" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> <%= __('Back') || 'واپس' %></a>
    </div>

    <!-- Expandable Filter Chips -->
    <div class="card shadow-sm border-0 rounded-4 mb-4" style="background: rgba(255, 255, 255, 0.9); backdrop-filter: blur(10px);">
        <div class="card-body p-3">
            <small class="text-muted d-block mb-2 fw-bold"><i class="bi bi-building me-1"></i><%= __('Filter_By_Class') || 'Filter By Class' %></small>
            <div class="d-flex flex-wrap gap-2">
                <a href="/exams/<%= exam.id %>/results" class="btn btn-sm <%= !selectedClassId ? 'btn-primary' : 'btn-outline-primary' %> rounded-pill px-3"><%= __('All') || 'All' %></a>
                <% classes.forEach(c => { %>
                    <% const isSelected = selectedClassId == c.id; %>
                    <a href="/exams/<%= exam.id %>/results?classId=<%= c.id %>" class="btn btn-sm <%= isSelected ? 'btn-primary active' : 'btn-outline-primary' %> rounded-pill px-3"><%= c.name_ar %></a>
                <% }) %>
            </div>
        </div>
    </div>
    
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-bordered table-striped mb-0 text-center">
                <thead class="table-dark">
                    <tr>
                        <th><%= __('Student_ID') %></th>
                        <th><%= __('Name') %></th>
                        <th><%= __('Class') %></th>
                        <th><%= __('Actions') || 'Actions' %></th>
                    </tr>
                </thead>
                <tbody>
                    <% if (typeof students !== 'undefined' && students.length > 0) { %>
                        <% students.forEach(s => { %>
                            <tr>
                                <td class="align-middle"><%= s.id %></td>
                                <td class="align-middle text-start fw-semibold text-primary"><%= s.name %></td>
                                <td class="align-middle"><%= s.class_name %></td>
                                <td class="align-middle">
                                    <a href="/exams/<%= exam.id %>/student/<%= s.id %>/report-card" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                        <i class="bi bi-card-text me-1"></i> <%= __('View_Report_Card') %>
                                    </a>
                                </td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="4" class="text-center py-4 text-muted">
                                <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                                <%= __('No_students_found') || 'No students found for this filter.' %>
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>
<%- include('../partials/footer') %>
