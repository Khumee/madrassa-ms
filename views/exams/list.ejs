<%- include('../partials/header', { title: __('Manage_Exams') }) %>

<div class="container mt-1">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><%= __('Exams') %></h2>
        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#newExamModal"><%= __('Create_New_Exam') %></button>
    </div>

    <div class="table-responsive">
        <table class="table table-bordered table-striped">
            <thead class="table-dark">
                <tr>
                    <th><%= __('Exam_Name') %></th>
                    <th><%= __('Date_Created') %></th>
                    <th><%= __('Actions') %></th>
                </tr>
            </thead>
            <tbody>
                <% if (exams && exams.length > 0) { %>
                    <% exams.forEach(exam => { %>
                        <tr>
                            <td><%= exam.name %></td>
                            <td><%= new Date(exam.created_at).toLocaleDateString() %></td>
                            <td>
                                <div class="d-flex gap-1">
                                    <a href="/exams/<%= exam.id %>/papers" class="btn btn-sm btn-secondary"><i class="bi bi-list-task"></i> <%= __('All_Papers') || 'All Papers' %></a>

                                    <a href="/exams/<%= exam.id %>/results" class="btn btn-sm btn-success"><%= __('View_Results') %></a>
                                    <a href="/exams/<%= exam.id %>/datesheet" class="btn btn-sm btn-info"><i class="bi bi-calendar-event"></i> <%= __('Date_Sheet') || 'Date Sheet' %></a>
                                    <a href="/exams/<%= exam.id %>/export-papers" class="btn btn-sm btn-outline-dark"><i class="bi bi-download"></i> <%= __('Export_All_Papers') || 'Export All Papers' %></a>
                                    <% if (session.role === 'مدير') { %>
                                        <button type="button" class="btn btn-sm btn-danger btn-delete-exam" data-exam-id="<%= exam.id %>" data-exam-name="<%= exam.name %>"><%= __('Delete') %></button>
                                    <% } %>
                                </div>
                            </td>
                        </tr>
                    <% }) %>
                <% } else { %>
                    <tr>
                        <td colspan="3" class="text-center"><%= __('No_exams_found') %></td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</div>

<!-- New Exam Modal -->
<div class="modal fade" id="newExamModal" tabindex="-1">
    <div class="modal-dialog">
        <form action="/exams" method="POST" class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><%= __('Create_New_Exam') %></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label"><%= __('Exam_Type') || 'Exam Type' %></label>
                    <select name="exam_type" class="form-select" required>
                        <option value="mid_year"><%= __('Exam_Type_MidYear') || 'Mid-Year' %></option>
                        <option value="annual"><%= __('Exam_Type_Annual') || 'Final / Annual' %></option>
                        <option value="quarterly"><%= __('Exam_Type_Quarterly') || 'Quarterly' %></option>
                        <option value="monthly"><%= __('Exam_Type_Monthly') || 'Monthly' %></option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label"><%= __('Year') || 'Year' %></label>
                    <input type="number" name="exam_year" class="form-control" value="<%= new Date().getFullYear() %>" min="2000" max="2100" required>
                </div>
                <div class="form-text"><%= __('Exam_Name_Auto_Note') || 'Exam name is generated automatically from the type and year, in whichever language is active when it is viewed.' %></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><%= __('Cancel') %></button>
                <button type="submit" class="btn btn-primary"><%= __('Create_New_Exam') %></button>
            </div>
        </form>
    </div>
</div>

<!-- Delete Exam Modal (type-to-confirm) -->
<div class="modal fade" id="deleteExamModal" tabindex="-1">
    <div class="modal-dialog">
        <form id="deleteExamForm" method="POST" class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title text-danger"><i class="bi bi-exclamation-triangle-fill me-1"></i> <%= __('Delete_Exam') || 'Delete Exam' %></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p><%- (__('Delete_Exam_Soft_Delete_Note') || 'This will remove "%s" from your exams list. Its papers, questions, and results are NOT deleted - they stay in the database.').replace('%s', '<strong id="deleteExamNameLabel"></strong>') %></p>
                <label class="form-label"><%= __('Type_Exam_Name_To_Confirm') || 'Type the exam name to confirm:' %></label>
                <input type="text" name="confirm_text" id="deleteExamConfirmInput" class="form-control" autocomplete="off" required>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><%= __('Cancel') %></button>
                <button type="submit" id="deleteExamSubmitBtn" class="btn btn-danger" disabled><%= __('Delete') %></button>
            </div>
        </form>
    </div>
</div>

<script>
    (function() {
        const modalEl = document.getElementById('deleteExamModal');
        const form = document.getElementById('deleteExamForm');
        const nameLabel = document.getElementById('deleteExamNameLabel');
        const input = document.getElementById('deleteExamConfirmInput');
        const submitBtn = document.getElementById('deleteExamSubmitBtn');
        let expectedName = '';

        document.querySelectorAll('.btn-delete-exam').forEach(btn => {
            btn.addEventListener('click', () => {
                expectedName = btn.dataset.examName;
                form.action = '/exams/' + btn.dataset.examId + '/delete';
                nameLabel.textContent = expectedName;
                input.value = '';
                submitBtn.disabled = true;
                new bootstrap.Modal(modalEl).show();
            });
        });

        input.addEventListener('input', () => {
            submitBtn.disabled = input.value.trim() !== expectedName;
        });
    })();
</script>

<%- include('../partials/footer') %>
