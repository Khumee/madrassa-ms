<%- include('../partials/header', { title: __('Build_Paper') }) %>
<div class="container mt-4">
    <h2>Build Paper: <%= paper.subject %> (Max Marks: <%= paper.max_marks %>)</h2>
    
    
    <div class="card mb-4">
        <div class="card-header"><%= __('Add_Question') %></div>
        <div class="card-body">
            <form action="/papers/<%= paper.id %>/questions" method="POST">
                <input type="text" name="question_text" class="form-control mb-2" placeholder="Question Text" required>
                <input type="number" name="marks" class="form-control mb-2" placeholder="Marks" required>
                <input type="text" name="section" class="form-control mb-2" placeholder="Section (Optional)">
                <button type="submit" class="btn btn-primary"><%= __('Add_Question') %></button>
            </form>
        </div>
    </div>
    
    <h4>Current Questions</h4>
    <ul class="list-group">
        <% questions.forEach(q => { %>
            <li class="list-group-item d-flex justify-content-between align-items-center">
                <div>
                    <span class="badge bg-secondary me-2"><%= __('Section') || 'Sec' %>: <%= q.section %></span>
                    <span><%= q.question_text %></span>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-dark"><%= q.marks %> <%= __('Marks') %></span>
                    <button class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#editQuestionModal<%= q.id %>"><%= __('Edit') || 'Edit' %></button>
                    <form action="/questions/<%= q.id %>/delete" method="POST" class="m-0" onsubmit="event.preventDefault(); const form = this; showConfirm('<%= __('Are_you_sure_you_want_to_delete_this') || 'Are you sure?' %>').then(c => { if(c) form.submit(); });">
                        <button type="submit" class="btn btn-sm btn-outline-danger"><%= __('Delete') || 'Delete' %></button>
                    </form>
                </div>
            </li>

            <!-- Edit Modal for Question <%= q.id %> -->
            <div class="modal fade" id="editQuestionModal<%= q.id %>" tabindex="-1">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <form action="/questions/<%= q.id %>/edit" method="POST">
                            <div class="modal-header">
                                <h5 class="modal-title"><%= __('Edit_Question') || 'Edit Question' %></h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                            </div>
                            <div class="modal-body">
                                <div class="mb-3">
                                    <label class="form-label"><%= __('Question') || 'Question' %></label>
                                    <input type="text" name="question_text" class="form-control" value="<%= q.question_text %>" required>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label"><%= __('Marks') || 'Marks' %></label>
                                    <input type="number" name="marks" class="form-control" value="<%= q.marks %>" required>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label"><%= __('Section') || 'Section' %></label>
                                    <input type="text" name="section" class="form-control" value="<%= q.section %>">
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><%= __('Cancel') || 'Cancel' %></button>
                                <button type="submit" class="btn btn-primary"><%= __('Save_Changes') || 'Save Changes' %></button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        <% }) %>
    </ul>
</div>
<%- include('../partials/footer') %>
