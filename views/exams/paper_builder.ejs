<%- include('../partials/header', { title: __('Build_Paper') }) %>
<div class="container mt-1">
    <h2>Build Paper: <%= paper.subject %> (Total Marks: <span id="paperTotal"><%= paper.max_marks %></span>)</h2>

    <div class="card mb-4">
        <div class="card-header fw-bold"><i class="bi bi-plus-circle me-1"></i> <%= __('Add_Question') %></div>
        <div class="card-body">
            <form id="quickAddForm" action="/papers/<%= paper.id %>/questions/with-choice" method="POST">
                <div id="quickAddParts">
                    <div class="mb-3 quick-add-part">
                        <label class="form-label text-muted"><%= __('Question_Text') || 'Question Text' %></label>
                        <textarea name="question_text" rows="3" class="form-control form-control-lg" placeholder="<%= __('Type_your_question_here') || 'Question Text' %>" required></textarea>
                    </div>
                </div>

                <div class="form-check mb-3">
                    <input class="form-check-input" type="checkbox" id="quickAddChoiceToggle" onchange="quickAddToggleChoice()">
                    <label class="form-check-label" for="quickAddChoiceToggle"><%= __('Has_Choice_Toggle') || 'Give the student a choice between alternatives' %></label>
                </div>

                <div id="quickAddChoiceExtras" class="d-none mb-3">
                    <button type="button" class="btn btn-sm btn-outline-secondary mb-2" onclick="quickAddAddAlternative()"><i class="bi bi-plus-lg me-1"></i> <%= __('Add_Alternative') || 'Add Another Alternative' %></button>
                    <div class="d-flex align-items-center gap-2">
                        <span class="text-muted small"><%= __('Required_Count_Short') || 'Answer' %></span>
                        <input type="number" name="required_count" id="quickAddRequiredCount" class="form-control form-control-sm" style="width: 70px;" value="1" min="1">
                        <span class="text-muted small"><%= __('Required_Count_Of') || 'of these' %></span>
                    </div>
                </div>

                <div class="row g-2 align-items-end mb-1">
                    <div class="col-sm-3">
                        <label class="form-label text-muted"><%= __('Marks') || 'Marks' %></label>
                        <input type="number" name="marks" class="form-control form-control-lg" min="1" required>
                    </div>
                    <div class="col-sm-4" id="quickAddSectionField">
                        <label class="form-label text-muted"><%= __('Section') || 'Section' %> <span class="fw-normal">(<%= __('Optional') || 'Optional' %>)</span></label>
                        <input type="text" name="section" class="form-control form-control-lg">
                    </div>
                    <div class="col-sm-auto ms-sm-auto">
                        <button type="submit" class="btn btn-primary btn-lg px-4 w-100"><i class="bi bi-plus-lg me-1"></i> <%= __('Add_Question') %></button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <script>
        (function() {
            const i18nAlternative = <%- JSON.stringify(__('Alternative_Part') || 'Alternative') %>;

            window.quickAddToggleChoice = function() {
                const on = document.getElementById('quickAddChoiceToggle').checked;
                document.getElementById('quickAddChoiceExtras').classList.toggle('d-none', !on);
                document.getElementById('quickAddSectionField').classList.toggle('d-none', on);
                const parts = document.querySelectorAll('#quickAddParts .quick-add-part');
                if (on && parts.length === 1) {
                    quickAddAddAlternative();
                } else if (!on) {
                    parts.forEach((el, i) => { if (i > 0) el.remove(); });
                }
            };

            window.quickAddAddAlternative = function() {
                const container = document.getElementById('quickAddParts');
                const div = document.createElement('div');
                div.className = 'mb-3 quick-add-part';
                div.innerHTML = '<label class="form-label text-muted">' + i18nAlternative + '</label>' +
                    '<div class="input-group"><textarea name="question_text" rows="3" class="form-control form-control-lg"></textarea>' +
                    '<button type="button" class="btn btn-outline-danger" onclick="quickAddRemovePart(this)"><i class="bi bi-x-lg"></i></button></div>';
                container.appendChild(div);
                quickAddSyncRequiredMax();
            };

            window.quickAddRemovePart = function(btn) {
                btn.closest('.quick-add-part').remove();
                quickAddSyncRequiredMax();
            };

            window.quickAddSyncRequiredMax = function() {
                const count = document.querySelectorAll('#quickAddParts .quick-add-part').length;
                const input = document.getElementById('quickAddRequiredCount');
                input.max = count;
                if (Number(input.value) > count) input.value = count;
            };
        })();
    </script>

    <!-- Hidden form that the ungrouped-question checkboxes below submit into -->
    <form id="groupForm" action="/papers/<%= paper.id %>/choice-groups" method="POST"></form>

    <div class="card mb-4 border-primary d-none" id="groupBar">
        <div class="card-body d-flex align-items-center gap-3 flex-wrap">
            <strong><span id="groupSelectedCount">0</span> <%= __('Questions_Selected') || 'question(s) selected' %></strong>
            <label class="mb-0"><%= __('Answer_Any') || 'Student must answer' %>
                <input type="number" name="required_count" form="groupForm" id="requiredCountInput" class="form-control d-inline-block" style="width: 70px;" value="1" min="1">
                <%= __('Of_Them') || 'of them' %>
            </label>
            <button type="submit" form="groupForm" class="btn btn-sm btn-primary"><%= __('Group_As_Choice') || 'Group as Choice' %></button>
        </div>
    </div>

    <h4><%= __('Current_Questions') || 'Current Questions' %></h4>
    <div class="d-flex flex-column gap-2">
        <% items.forEach(item => { %>
            <% if (item.type === 'single') { %>
                <% const q = item.question; %>
                <ul class="list-group">
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-center gap-2">
                            <input type="checkbox" class="form-check-input group-checkbox" name="question_ids" form="groupForm" value="<%= q.id %>" data-marks="<%= q.marks %>">
                            <span class="badge bg-secondary"><%= __('Section') || 'Sec' %>: <%= q.section %></span>
                            <span><%= q.question_text %></span>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge bg-dark"><%= q.marks %> <%= __('Marks') %></span>
                            <button class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#editQuestionModal<%= q.id %>"><%= __('Edit') || 'Edit' %></button>
                            <form action="/questions/<%= q.id %>/delete" method="POST" class="m-0" onsubmit="event.preventDefault(); const form = this; showConfirm('<%= __('Are_you_sure_you_want_to_delete_this') || 'Are you sure?' %>').then(c => { if(c) form.submit(); });">
                                <button type="submit" class="btn btn-sm btn-outline-danger"><%= __('Delete') || 'Delete' %></button>
                            </form>
                        </div>
                    </li>
                </ul>
                <%- include('_edit_question_modal', { q }) %>
            <% } else { %>
                <div class="card border-info">
                    <div class="card-header bg-info-subtle d-flex justify-content-between align-items-center py-1">
                        <small class="fw-bold">
                            <%= __('Choice_Group') || 'Choice group' %> —
                            <%= (__('Answer_N_Of_M') || 'Answer any {n} of {m}').replace('{n}', item.requiredCount).replace('{m}', item.members.length) %>
                        </small>
                        <form action="/choice-groups/<%= item.groupId %>/ungroup" method="POST" class="m-0">
                            <button type="submit" class="btn btn-sm btn-outline-secondary py-0"><%= __('Ungroup') || 'Ungroup' %></button>
                        </form>
                    </div>
                    <ul class="list-group list-group-flush">
                        <% item.members.forEach((q, idx) => { %>
                            <% if (idx > 0) { %>
                                <li class="list-group-item text-center text-muted py-1 fst-italic small">— <%= __('Or') || 'or' %> —</li>
                            <% } %>
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <div>
                                    <span class="badge bg-secondary me-2"><%= __('Section') || 'Sec' %>: <%= q.section %></span>
                                    <span><%= q.question_text %></span>
                                </div>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="badge bg-dark"><%= q.marks %> <%= __('Marks') %></span>
                                    <button class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#editQuestionModal<%= q.id %>"><%= __('Edit') || 'Edit' %></button>
                                    <form action="/questions/<%= q.id %>/delete" method="POST" class="m-0" onsubmit="event.preventDefault(); const form = this; showConfirm('<%= __('Are_you_sure_you_want_to_delete_this') || 'Are you sure?' %>').then(c => { if(c) form.submit(); });">
                                        <button type="submit" class="btn btn-sm btn-outline-danger"><%= __('Delete') || 'Delete' %></button>
                                    </form>
                                </div>
                            </li>
                            <%- include('_edit_question_modal', { q }) %>
                        <% }) %>
                    </ul>
                    <div class="card-footer py-1 text-end">
                        <form action="/choice-groups/<%= item.groupId %>/edit" method="POST" class="d-inline-flex align-items-center gap-2 m-0">
                            <label class="small mb-0"><%= __('Required_Count') || 'Required count' %></label>
                            <input type="number" name="required_count" class="form-control form-control-sm" style="width: 60px;" value="<%= item.requiredCount %>" min="1" max="<%= item.members.length %>">
                            <button type="submit" class="btn btn-sm btn-outline-secondary"><%= __('Save_Changes') || 'Save' %></button>
                        </form>
                    </div>
                </div>
            <% } %>
        <% }) %>
        <% if (!items.length) { %>
            <div class="text-muted"><%= __('No_Questions_Yet') || 'No questions yet. Add one above.' %></div>
        <% } %>
    </div>
</div>

<script>
    const checkboxes = document.querySelectorAll('.group-checkbox');
    const groupBar = document.getElementById('groupBar');
    const countLabel = document.getElementById('groupSelectedCount');
    const requiredInput = document.getElementById('requiredCountInput');

    function refreshGroupBar() {
        const checked = Array.from(checkboxes).filter(c => c.checked);

        if (checked.length >= 2) {
            groupBar.classList.remove('d-none');
            countLabel.textContent = checked.length;
            requiredInput.max = checked.length;
            if (Number(requiredInput.value) > checked.length) requiredInput.value = checked.length;
        } else {
            groupBar.classList.add('d-none');
        }
    }

    checkboxes.forEach(c => c.addEventListener('change', refreshGroupBar));
</script>

<%- include('../partials/footer') %>
