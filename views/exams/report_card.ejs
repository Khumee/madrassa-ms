<%- include('../partials/header', { title: __('Student_Report_Card') || 'Report Card' }) %>

<!-- Print styling -->
<style>
    @media print {
        body * {
            visibility: hidden;
        }
        .printable-area, .printable-area * {
            visibility: visible;
        }
        .printable-area {
            position: absolute;
            left: 0;
            top: 0;
            width: 100%;
        }
        .no-print {
            display: none !important;
        }
        .card {
            border: none !important;
            box-shadow: none !important;
        }
    }
    
    .report-card-container {
        max-width: 800px;
        margin: auto;
        border: 2px solid #2c3e50;
        border-radius: 12px;
        background-color: #fff;
    }
    
    .watermark {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        opacity: 0.05;
        z-index: 0;
        width: 80%;
        pointer-events: none;
    }
</style>

<div class="container mt-4 mb-5">
    <div class="text-end mb-3 no-print">
        <a href="/exams/<%= exam.id %>/results" class="btn btn-outline-secondary me-2"><i class="bi bi-arrow-left"></i> <%= __('Back') || 'واپس' %></a>
        <button onclick="window.print()" class="btn btn-dark"><i class="bi bi-printer"></i> <%= __('Print_Report_Card') || 'Print' %></button>
    </div>

    <div class="card shadow-lg p-3 p-md-4 report-card-container printable-area position-relative">
        <% if (locals.tenant && locals.tenant.logo_url) { %>
            <img src="<%= tenant.logo_url %>" alt="Madrassa Logo" class="watermark">
        <% } %>

        <!-- Header Section -->
        <div class="row mb-2 align-items-center" style="position: relative; z-index: 1;">
            <div class="col-3 text-center">
                <% if (locals.tenant && locals.tenant.logo_url) { %>
                    <img src="<%= tenant.logo_url %>" alt="Logo" style="max-height: 70px; max-width: 100%;">
                <% } %>
            </div>
            <div class="col-6 text-center">
                <h2 class="fw-bold text-dark mb-1" style="white-space: nowrap;"><%= locals.tenant ? (tenant.subdomain === 'madrassa-ms' ? __('Jamia_Habibullah_Islamabad') : (tenant.subdomain === 'kui' ? __('KUI_Production') : tenant.school_name)) : __('College_Name') %></h2>
                <h5 class="text-secondary mb-2"><%= exam.name %></h5>
                <h6 class="fw-bold bg-dark text-white d-inline-block px-3 py-1 rounded-pill mb-0"><%= __('Student_Report_Card') || 'Report Card' %></h6>
            </div>
            <div class="col-3 text-center">
                <!-- Optional placeholder for student photo or QR -->
            </div>
        </div>

        <hr style="border-top: 2px solid #2c3e50; opacity: 1;" class="my-2">
        
        <!-- Student Details -->
        <div class="row mb-2" style="position: relative; z-index: 1;">
            <div class="col-md-6">
                <table class="table table-sm table-borderless mb-0">
                    <tr>
                        <th width="40%" class="text-muted"><%= __('Name') %>:</th>
                        <td class="fw-bold fs-6"><%= student.name %></td>
                    </tr>
                    <tr>
                        <th class="text-muted"><%= __('Roll_Number') %>:</th>
                        <td class="fw-bold"><%= student.roll_number %></td>
                    </tr>
                </table>
            </div>
        </div>
        
        <!-- Results Table -->
        <div style="position: relative; z-index: 1;">
            <table class="table table-bordered table-sm text-center align-middle border-dark mb-2">
                <thead class="table-dark">
                    <tr>
                        <th class="py-1"><%= __('Subject') %></th>
                        <th class="py-1"><%= __('Max_Marks') %></th>
                        <th class="py-1"><%= __('Obtained_Marks') %></th>
                    </tr>
                </thead>
                <tbody>
                    <% results.forEach(r => { %>
                        <tr>
                            <td class="fw-semibold text-start px-3 py-1"><%= r.subject %></td>
                            <td class="py-1"><%= r.max_marks %></td>
                            <% if (r.obtained_marks !== null) { %>
                                <td class="fw-bold py-1 <%= r.obtained_marks < (r.max_marks * 0.4) ? 'text-danger' : '' %>"><%= r.obtained_marks %></td>
                            <% } else { %>
                                <td class="text-muted fst-italic py-1">-</td>
                            <% } %>
                        </tr>
                    <% }) %>
                    <tr class="table-secondary border-dark">
                        <td class="fw-bold text-start px-3 py-1"><%= __('Total') %></td>
                        <td class="fw-bold py-1"><%= totalMax %></td>
                        <td class="fw-bold py-1"><%= allPapersUnmarked ? '-' : totalObtained %></td>
                    </tr>
                </tbody>
            </table>
        </div>
        
        <!-- Grading Section -->
        <div class="mt-2 p-2 rounded bg-light border" style="position: relative; z-index: 1;">
            <div class="row align-items-center text-center">
                <div class="col-md-6 border-end">
                    <h6 class="text-muted mb-1"><%= __('Percentage') %></h6>
                    <h4 class="fw-bold mb-0 <%= allPapersUnmarked ? 'text-muted' : '' %>"><%= allPapersUnmarked ? '-' : percentage + '%' %></h4>
                </div>
                <div class="col-md-6">
                    <h6 class="text-muted mb-1"><%= __('Grade') %></h6>
                    <% if (allPapersUnmarked) { %>
                        <h5 class="fw-bold text-muted mb-0"><%= __('Papers_not_marked') || 'Papers not marked yet' %></h5>
                    <% } else { %>
                        <h4 class="fw-bold text-<%= gradeClass %> mb-0"><%= grade %></h4>
                    <% } %>
                </div>
            </div>
        </div>
        
        <!-- Signatures -->
        <div class="row mt-4 pt-4 text-center" style="position: relative; z-index: 1;">
            <div class="col-6">
                <hr style="width: 60%; margin: 0 auto 5px auto; border-top: 1px solid #000; opacity: 1;">
                <strong><%= __('Class_Teacher') || 'Class Teacher' %></strong>
            </div>
            <div class="col-6">
                <hr style="width: 60%; margin: 0 auto 5px auto; border-top: 1px solid #000; opacity: 1;">
                <strong><%= __('Principal') || 'Principal' %></strong>
            </div>
        </div>
    </div>
</div>
<%- include('../partials/footer') %>
