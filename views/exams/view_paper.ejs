<%- include('../partials/header', { title: __('View_Paper') || 'View Paper' }) %>
</div> <!-- Close the container from header.ejs -->

<style>
    body {
        background-color: #f8f9fa;
    }

    .paper-container {
        direction: rtl;
        text-align: right;
        background: #fff;
        width: 210mm;
        min-height: 297mm;
        margin: 20px auto;
        padding: 15mm 20mm;
        box-shadow: 0 0 15px rgba(0,0,0,0.1);
        position: relative;
        color: #000;
        line-height: 1.6;
    }

    .thick-line {
        border-top: 3px solid #000;
        border-bottom: 1px solid #000;
        height: 6px;
        background: transparent;
        margin: 10px 0;
        opacity: 1;
    }

    .note-section {
        text-align: center;
        font-size: 0.9rem;
        font-weight: bold;
        margin-bottom: 15px;
    }
    
    .note-section p {
        margin-bottom: 5px;
    }

    .subject-title {
        font-size: 1rem;
        font-weight: bold;
        text-decoration: underline;
        text-align: center;
    }

    .question-block {
        margin-bottom: 25px;
        font-size: 1.2rem;
    }

    .question-actions {
        opacity: 0.2;
        transition: opacity 0.2s;
    }

    .question-block:hover .question-actions {
        opacity: 1;
    }

    .question-text-view {
        white-space: pre-wrap;
        display: inline-block;
        width: 100%;
        line-height: 1.8;
        text-align: right;
    }

    .empty-lines {
        margin-top: 15px;
        border-bottom: 1px dashed #777;
        height: 35px;
        width: 100%;
    }

    .edit-mode {
        display: none;
    }

    .question-block.editing .view-mode {
        display: none;
    }

    .question-block.editing .edit-mode {
        display: block;
    }

    .question-block.editing .question-actions {
        display: none;
    }

    #note-section.editing .view-mode {
        display: none;
    }

    #note-section.editing .edit-mode {
        display: block;
    }

    .print-only {
        display: none;
    }

    /* Mobile: the paper is authored/printed at a fixed A4 width (210mm), which
       overflows every phone screen and forces horizontal scrolling while
       editing/pasting a question. Below tablet width, let the container
       shrink to the viewport instead and tone down the print-sized type. */
    @media (max-width: 768px) {
        .paper-container {
            width: 100%;
            min-height: auto;
            margin: 10px auto;
            padding: 15px;
        }

        .question-block {
            font-size: 1rem;
            margin-bottom: 20px;
        }

        .question-text-view {
            line-height: 1.5;
        }

        .empty-lines {
            height: 26px;
            margin-top: 10px;
        }

        /* Hover-to-reveal doesn't exist on touch screens - keep the
           edit/delete actions visible so they're reachable at all. */
        .question-actions {
            opacity: 1;
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
            margin-top: 8px !important;
        }

        .question-actions .btn {
            flex: 1 1 auto;
        }

        .paper-container .d-flex.justify-content-between.align-items-center {
            flex-wrap: wrap;
            row-gap: 10px;
        }

        .paper-container .text-center,
        .paper-container .text-start,
        .paper-container .text-end {
            text-align: center !important;
        }

        .quick-add-marks-col {
            width: 100% !important;
        }
    }

    @media print {
        body {
            background: #fff;
            margin: 0;
            padding: 10mm;
        }
        .navbar, footer, .btn, .question-actions, .no-print {
            display: none !important;
        }
        .paper-container {
            margin: 0;
            padding: 0;
            box-shadow: none;
            width: 100%;
            min-height: auto;
            border: none;
        }
        .print-only {
            display: block;
        }
        /* On screen the extra margin/height gives room for the edit toolbar
           and makes blank answer space easy to see. None of that is needed
           on paper, so tighten everything down for print to avoid leaving
           empty gaps between questions. */
        .question-block {
            margin-bottom: 8px;
        }
        .empty-lines {
            margin-top: 6px;
            height: 22px;
        }
        .note-section {
            margin-bottom: 8px;
        }
        .note-section p {
            margin-bottom: 3px;
        }
        .thick-line {
            margin: 6px 0;
        }
        @page {
            size: A4;
            margin: 0;
        }
    }
</style>

<div class="paper-container">
    <!-- Compact Header (Under 1 inch) -->
    <div class="d-flex justify-content-between align-items-center" style="margin-bottom: 5px; min-height: 50px;">
        <!-- Right side (Logo and Marks) -->
        <div class="d-flex align-items-center text-end">
            <img src="/logo.jpg" alt="Logo" style="height: 50px; margin-left: 10px;" onerror="this.style.display='none'">
            <div style="font-size: 1rem;">
                <%
                    const urduDigits = ['٠', '١', '٢', '٣', '٤', '٥', '٦', '٧', '٨', '٩'];
                    let urduTotal = String(paper.max_marks || 0).replace(/[0-9]/g, d => urduDigits[d]);
                %>
                <span class="d-block fw-bold">مجموع الدرجات <%= urduTotal %></span>
            </div>
        </div>
        
        <!-- Center (Title) -->
        <div class="text-center">
            <p class="mb-0" style="font-size: 0.8rem;">بسم الله الرحمن الرحيم</p>
            <h4 class="fw-bold mb-0" style="font-size: 1.5rem;">کلیۃ العلوم الاسلامیہ</h4>
            <div class="fw-bold" style="font-size: 1.1rem;">الاختبار السنوي  [<%= paper.class_name %>]</div>
        </div>
        
        <!-- Left side (Time/Date) -->
        <div class="text-start" style="font-size: 1rem;">
            <span class="d-block fw-bold">تاریخ: <%= paper.paper_date ? new Date(paper.paper_date).toLocaleDateString('ur-PK') : new Date().toLocaleDateString('ur-PK') %></span>
            <span class="d-block fw-bold">الوقت ٣ ساعات</span>
        </div>
    </div>
    
    <div class="thick-line"></div>
    
    <% const hasChoiceGroups = items && items.some(it => it.type === 'group'); %>
    <% const defaultNoteText = hasChoiceGroups
        ? `ملحوظة: 'یا' سے جڑے سوالات میں سے مطلوبہ تعداد میں کسی کا جواب لکھیں۔ صحیح عربی میں پرچہ حل کرنے پر انشاء عربی کے پانچ نمبر ہوں گے۔`
        : `ملحوظة: صحیح عربی میں پرچہ حل کرنے پر انشاء عربی کے پانچ نمبر ہوں گے۔`; %>
    <div class="note-section" id="note-section">
        <div class="view-mode">
            <p style="white-space: pre-wrap;"><%= paper.note_text || defaultNoteText %></p>
            <button type="button" class="btn btn-sm btn-outline-secondary no-print" onclick="toggleNoteEdit()" title="<%= __('Edit_Note') || 'ملحوظة میں ترمیم کریں' %>"><i class="bi bi-pencil"></i></button>
        </div>
        <div class="edit-mode no-print mt-2 mb-3" dir="rtl">
            <form action="/papers/<%= paper.id %>/note" method="POST">
                <textarea name="note_text" class="form-control text-end" rows="3" style="direction: rtl;" placeholder="<%= __('Default_Note_Placeholder') || 'خالی چھوڑنے پر ڈیفالٹ ملحوظة دکھایا جائے گا' %>"><%= paper.note_text || '' %></textarea>
                <div class="mt-2">
                    <button type="submit" class="btn btn-sm btn-success"><i class="bi bi-check-lg"></i> <%= __('Save_Changes') || 'Save Changes' %></button>
                    <button type="button" class="btn btn-sm btn-secondary" onclick="toggleNoteEdit()"><%= __('Cancel') || 'Cancel' %></button>
                </div>
            </form>
        </div>
        <div class="subject-title">الورقة في مادة (<%= paper.subject %>) - المعلم: <%= paper.teacher_name %></div>
    </div>

    <!-- Questions Area -->
    <div id="questions-area">
        <% if (items && items.length > 0) { %>
            <%
                const partLetters = ['الف', 'ب', 'ج', 'د', 'ہ', 'و', 'ز', 'ح', 'ط', 'ی'];
                const renderEntries = [];
                items.forEach((item, idx) => {
                    const questionNum = idx + 1;
                    if (item.type === 'single') {
                        renderEntries.push({ q: item.question, label: `سوال ${questionNum}:`, orBefore: false, groupNote: null });
                    } else if (item.requiredCount === 1) {
                        item.members.forEach((q, mi) => {
                            renderEntries.push({ q, label: `سوال ${questionNum} (حصہ ${partLetters[mi] || (mi + 1)}):`, orBefore: mi > 0, groupNote: null });
                        });
                    } else {
                        item.members.forEach((q, mi) => {
                            renderEntries.push({
                                q,
                                label: `سوال ${questionNum} (${partLetters[mi] || (mi + 1)}):`,
                                orBefore: false,
                                groupNote: mi === 0 ? `کسی بھی ${item.requiredCount} کا جواب دیں:` : null
                            });
                        });
                    }
                });
                const urduDigitsLocal = ['٠', '١', '٢', '٣', '٤', '٥', '٦', '٧', '٨', '٩'];
            %>
            <% renderEntries.forEach(entry => {
                const q = entry.q;
                let qMarksUrdu = String(q.marks || 0).replace(/[0-9]/g, d => urduDigitsLocal[d]);
            %>
                <% if (entry.orBefore) { %>
                    <div class="text-center fw-bold my-2 fs-5">...یا...</div>
                <% } %>
                <% if (entry.groupNote) { %>
                    <div class="fw-bold my-2"><%= entry.groupNote %></div>
                <% } %>

                <div class="question-block" id="question-<%= q.id %>">
                    <!-- View Mode -->
                    <div class="view-mode">
                        <div class="question-text-view"><strong class="me-2"><%= entry.label %></strong> <%= q.question_text ? q.question_text.trim() : '' %> <span class="ms-1">(<%= qMarksUrdu %>)</span></div>

                        <!-- Empty lines for answers -->
                        <% if (!q.question_text || q.question_text.trim() === '') { %>
                            <div class="empty-lines"></div>
                            <div class="empty-lines"></div>
                            <div class="empty-lines"></div>
                            <div class="empty-lines"></div>
                        <% } %>

                        <!-- Actions (Hidden in Print) -->
                        <div class="question-actions no-print text-end mt-2">
                            <button class="btn btn-sm btn-primary px-3" onclick="toggleEdit('<%= q.id %>')" title="ترمیم کریں"><i class="bi bi-pencil"></i> ترمیم کریں</button>
                            <form action="/questions/<%= q.id %>/delete" method="POST" class="d-inline m-0" onsubmit="event.preventDefault(); const form = this; showConfirm('<%= __('Are_you_sure_you_want_to_delete_this') || 'کیا آپ واقعی حذف کرنا چاہتے ہیں؟' %>').then(c => { if(c) form.submit(); });">
                                <button type="submit" class="btn btn-sm btn-outline-danger px-3" title="حذف کریں"><i class="bi bi-trash"></i></button>
                            </form>
                        </div>
                    </div>

                    <!-- Edit Mode -->
                    <div class="edit-mode no-print mt-3 p-3 border rounded bg-light" dir="ltr">
                        <form action="/questions/<%= q.id %>/edit" method="POST">
                            <div class="mb-3 text-end" dir="rtl">
                                <label class="form-label fw-bold"><strong class="me-2 text-primary"><%= entry.label %></strong> <%= __('Question_Text') || 'Question Text' %></label>
                                <textarea name="question_text" class="form-control" rows="4" style="direction: rtl; font-size: 1.3rem;" placeholder="<%= __('Type_your_question_here') || 'اپنا سوال یہاں لکھیں...' %>"><%= q.question_text %></textarea>
                            </div>
                            <div class="row mb-3 text-start">
                                <div class="col-md-4">
                                    <label class="form-label fw-bold"><%= __('Marks') || 'Marks' %></label>
                                    <input type="number" name="marks" class="form-control" value="<%= q.marks %>" min="1">
                                </div>
                                <div class="col-6 d-none">
                                    <label class="form-label fw-bold"><%= __('Section') || 'Section / Hisa' %></label>
                                    <input type="text" name="section" class="form-control" value="<%= q.section %>" placeholder="مثلاً: حصہ الف">
                                </div>
                            </div>
                            <div class="text-end">
                                <button type="button" class="btn btn-secondary" onclick="toggleEdit('<%= q.id %>')"><%= __('Cancel') || 'Cancel' %></button>
                                <button type="submit" class="btn btn-success"><i class="bi bi-check-lg"></i> <%= __('Save_Changes') || 'Save Changes' %></button>
                            </div>
                        </form>
                    </div>
                </div>
            <% }) %>
        <% } else { %>
            <div class="text-center mt-5 no-print" dir="ltr">
                <div class="alert alert-info d-inline-block">
                    <i class="bi bi-info-circle"></i> <%= __('No_Questions_Found_For_Paper') || 'No questions found for this paper.' %>
                </div>
                <div class="mt-3">
                    <form action="/papers/<%= paper.id %>/generate-default" method="POST">
                        <button type="submit" class="btn btn-success btn-lg shadow-sm">
                            <i class="bi bi-magic"></i> <%= __('Generate_Default_Paper_Layout') || 'Generate Default Paper Layout' %>
                        </button>
                    </form>
                </div>
            </div>
        <% } %>

        <!-- Quick add (hidden in print) -->
        <div class="no-print mt-4 p-4 border rounded-3 bg-light" dir="rtl">
            <h6 class="fw-bold mb-3"><i class="bi bi-plus-circle me-1"></i> <%= __('Add_Question') || 'نیا سوال شامل کریں' %></h6>
            <form id="quickAddForm" action="/papers/<%= paper.id %>/questions/with-choice" method="POST">
                <div id="quickAddParts">
                    <div class="mb-3 quick-add-part">
                        <label class="form-label text-muted"><%= __('Question_Text') || 'سوال کی عبارت' %></label>
                        <textarea name="question_text" rows="3" class="form-control form-control-lg" placeholder="<%= __('Type_your_question_here') || 'اپنا سوال یہاں لکھیں...' %>"></textarea>
                    </div>
                </div>

                <div class="form-check mb-3">
                    <input class="form-check-input" type="checkbox" id="quickAddChoiceToggle" onchange="quickAddToggleChoice()">
                    <label class="form-check-label" for="quickAddChoiceToggle"><%= __('Has_Choice_Toggle') || 'طالب علم کو متبادل میں سے انتخاب کا موقع دیں' %></label>
                </div>

                <div id="quickAddChoiceExtras" class="d-none mb-3">
                    <button type="button" class="btn btn-sm btn-outline-secondary mb-2" onclick="quickAddAddAlternative()"><i class="bi bi-plus-lg me-1"></i> <%= __('Add_Alternative') || 'ایک اور متبادل شامل کریں' %></button>
                    <div class="d-flex align-items-center gap-2">
                        <span class="text-muted small"><%= __('Required_Count_Short') || 'جواب دیں' %></span>
                        <input type="number" name="required_count" id="quickAddRequiredCount" class="form-control form-control-sm" style="width: 70px;" value="1" min="1">
                        <span class="text-muted small"><%= __('Required_Count_Of') || 'میں سے' %></span>
                    </div>
                </div>

                <div class="row g-2 align-items-end">
                    <div class="col-auto quick-add-marks-col" style="width: 140px;">
                        <label class="form-label text-muted"><%= __('Marks') || 'Marks' %></label>
                        <input type="number" name="marks" class="form-control form-control-lg" min="1" required>
                    </div>
                    <div class="col-auto">
                        <button type="submit" class="btn btn-primary btn-lg px-4"><i class="bi bi-plus-lg me-1"></i> <%= __('Add_Question') || 'شامل کریں' %></button>
                    </div>
                </div>
            </form>
            <div class="text-muted small mt-3 pt-3 border-top">
                <i class="bi bi-info-circle me-1"></i> <%= (__('Group_Questions_In_Builder_Note') || 'انتخابی سوالات بنانے کے لیے "%s" استعمال کریں۔').replace('%s', __('Build_Paper')) %>
            </div>
        </div>

        <script>
            (function() {
                const i18nAlternative = <%- JSON.stringify(__('Alternative_Part') || 'متبادل') %>;

                window.quickAddToggleChoice = function() {
                    const on = document.getElementById('quickAddChoiceToggle').checked;
                    document.getElementById('quickAddChoiceExtras').classList.toggle('d-none', !on);
                    const parts = document.querySelectorAll('#quickAddParts .quick-add-part');
                    if (on && parts.length === 1) {
                        quickAddAddAlternative();
                    } else if (!on) {
                        parts.forEach((el, i) => { if (i > 0) el.remove(); });
                    }
                };

                window.quickAddAddAlternative = function() {
                    const container = document.getElementById('quickAddParts');
                    const div = document.createElement('div');
                    div.className = 'mb-3 quick-add-part';
                    div.innerHTML = '<label class="form-label text-muted">' + i18nAlternative + '</label>' +
                        '<div class="input-group"><textarea name="question_text" rows="3" class="form-control form-control-lg"></textarea>' +
                        '<button type="button" class="btn btn-outline-danger" onclick="quickAddRemovePart(this)"><i class="bi bi-x-lg"></i></button></div>';
                    container.appendChild(div);
                    quickAddSyncRequiredMax();
                };

                window.quickAddRemovePart = function(btn) {
                    btn.closest('.quick-add-part').remove();
                    quickAddSyncRequiredMax();
                };

                window.quickAddSyncRequiredMax = function() {
                    const count = document.querySelectorAll('#quickAddParts .quick-add-part').length;
                    const input = document.getElementById('quickAddRequiredCount');
                    input.max = count;
                    if (Number(input.value) > count) input.value = count;
                };
            })();
        </script>
    </div>
</div>

<div class="container no-print mt-4 mb-5 text-center" style="max-width: 210mm;">
    <a href="javascript:history.back()" class="btn btn-outline-secondary btn-lg"><i class="bi bi-arrow-left"></i> واپس</a>
    <button onclick="window.print()" class="btn btn-outline-primary btn-lg ms-3"><i class="bi bi-printer"></i> پرنٹ کریں</button>
    <a href="/papers/<%= paper.id %>/export" class="btn btn-outline-dark btn-lg ms-3"><i class="bi bi-download"></i> <%= __('Export_Paper') || 'پرچہ ایکسپورٹ کریں' %></a>
    <button type="button" class="btn btn-outline-dark btn-lg ms-3" onclick="document.getElementById('importPaperFile').click()"><i class="bi bi-upload"></i> <%= __('Import_Paper') || 'پرچہ امپورٹ کریں' %></button>
    <form id="importPaperForm" action="/papers/<%= paper.id %>/import" method="POST" enctype="multipart/form-data" class="d-none">
        <input type="file" name="file" id="importPaperFile" accept="application/json" onchange="onImportPaperFileChosen()">
    </form>
</div>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const urlParams = new URLSearchParams(window.location.search);
        if (urlParams.get('print') === 'true') {
            setTimeout(() => { window.print(); }, 500);
        }
    });

    function toggleEdit(id) {
        const block = document.getElementById('question-' + id);
        block.classList.toggle('editing');
    }

    function toggleNoteEdit() {
        document.getElementById('note-section').classList.toggle('editing');
    }

    function onImportPaperFileChosen() {
        const input = document.getElementById('importPaperFile');
        if (!input.files || !input.files.length) return;
        const warning = <%- JSON.stringify(__('Import_Paper_Confirm') || 'یہ اس پرچے کے تمام موجودہ سوالات کی جگہ درآمد شدہ فائل کے سوالات لے لے گا۔ جاری رکھیں؟') %>;
        showConfirm(warning).then(c => {
            if (c) document.getElementById('importPaperForm').submit();
            else input.value = '';
        });
    }
</script>

<div class="container pb-5"> <!-- Re-open the container for footer.ejs -->
<%- include('../partials/footer') %>
