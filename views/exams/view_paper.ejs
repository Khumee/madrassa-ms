<%- include('../partials/header', { title: __('View_Paper') || 'View Paper' }) %>

<style>
    body {
        background-color: #f8f9fa;
    }

    .paper-container {
        direction: rtl;
        text-align: right;
        background: #fff;
        width: 210mm;
        min-height: 297mm;
        margin: 20px auto;
        padding: 15mm 20mm;
        box-shadow: 0 0 15px rgba(0,0,0,0.1);
        position: relative;
        color: #000;
        line-height: 1.6;
    }

    .thick-line {
        border-top: 3px solid #000;
        border-bottom: 1px solid #000;
        height: 6px;
        background: transparent;
        margin: 10px 0;
        opacity: 1;
    }

    .note-section {
        text-align: center;
        font-size: 0.9rem;
        font-weight: bold;
        margin-bottom: 15px;
    }
    
    .note-section p {
        margin-bottom: 5px;
    }

    .subject-title {
        font-size: 1rem;
        font-weight: bold;
        text-decoration: underline;
        text-align: center;
    }

    .question-block {
        margin-bottom: 25px;
        position: relative;
        font-size: 1.2rem;
    }

    .question-actions {
        position: absolute;
        top: -10px;
        left: -10px;
        opacity: 0.2;
        transition: opacity 0.2s;
        z-index: 100;
    }

    .question-block:hover .question-actions {
        opacity: 1;
    }

    .question-text-view {
        white-space: pre-wrap;
        display: inline-block;
        width: 100%;
        line-height: 1.8;
    }

    .empty-lines {
        margin-top: 15px;
        border-bottom: 1px dashed #777;
        height: 35px;
        width: 100%;
    }

    .edit-mode {
        display: none;
    }

    .question-block.editing .view-mode {
        display: none;
    }

    .question-block.editing .edit-mode {
        display: block;
    }

    .question-block.editing .question-actions {
        display: none;
    }

    .print-only {
        display: none;
    }

    @media print {
        body {
            background: #fff;
            margin: 0;
            padding: 0;
        }
        .container, .navbar, .footer, .btn, .question-actions, .no-print {
            display: none !important;
        }
        .paper-container {
            margin: 0;
            padding: 0;
            box-shadow: none;
            width: 100%;
            min-height: auto;
            border: none;
        }
        .print-only {
            display: block;
        }
        @page {
            size: A4;
            margin: 15mm;
        }
    }
</style>

<div class="paper-container">
    <!-- Compact Header (Under 1 inch) -->
    <div class="d-flex justify-content-between align-items-center" style="margin-bottom: 5px; min-height: 50px;">
        <!-- Right side (Logo and Marks) -->
        <div class="d-flex align-items-center text-end">
            <img src="/logo.jpg" alt="Logo" style="height: 50px; margin-left: 10px;" onerror="this.style.display='none'">
            <div style="font-size: 1rem;">
                <span class="d-block fw-bold">مجموع الدرجات ١٠٠</span>
            </div>
        </div>
        
        <!-- Center (Title) -->
        <div class="text-center">
            <p class="mb-0" style="font-size: 0.8rem;">بسم الله الرحمن الرحيم</p>
            <h4 class="fw-bold mb-0" style="font-size: 1.5rem;">کلیۃ العلوم الاسلامیہ</h4>
            <div class="fw-bold" style="font-size: 1.1rem;">الاختبار السنوي  [<%= paper.class_name %>]</div>
        </div>
        
        <!-- Left side (Time/Date) -->
        <div class="text-start" style="font-size: 1rem;">
            <span class="d-block fw-bold">تاریخ: <%= new Date().toLocaleDateString('ur-PK') %></span>
            <span class="d-block fw-bold">الوقت ٣ ساعات</span>
        </div>
    </div>
    
    <div class="thick-line"></div>
    
    <div class="note-section">
        <p>ملحوظة: ہر سوال کے دو حصوں (الف اور ب) میں سے کسی ایک کا جواب لکھیں۔ صحیح عربی میں پرچہ حل کرنے پر انشاء عربی کے پانچ نمبر ہوں گے۔</p>
        <div class="subject-title">الورقة في مادة (<%= paper.subject %>) - المعلم: <%= paper.teacher_name %></div>
    </div>

    <!-- Questions Area -->
    <div id="questions-area">
        <% if (questions && questions.length > 0) { %>
            <% questions.forEach((q, index) => { %>
                <div class="question-block" id="question-<%= q.id %>">
                    <!-- Actions (Hidden in Print) -->
                    <div class="question-actions no-print">
                        <button class="btn btn-sm btn-primary" onclick="toggleEdit('<%= q.id %>')" title="Edit"><i class="bi bi-pencil"></i></button>
                        <form action="/questions/<%= q.id %>/delete" method="POST" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this question?');">
                            <button type="submit" class="btn btn-sm btn-danger"><i class="bi bi-trash"></i></button>
                        </form>
                    </div>

                    <!-- View Mode -->
                    <div class="view-mode">
                        <div class="question-text-view"><%= q.question_text %></div>
                        
                        <!-- Empty lines for answers (3-4 lines as requested) -->
                        <div class="empty-lines"></div>
                        <div class="empty-lines"></div>
                        <div class="empty-lines"></div>
                        <div class="empty-lines"></div>
                    </div>

                    <!-- Edit Mode -->
                    <div class="edit-mode no-print mt-3 p-3 border rounded bg-light" dir="ltr">
                        <form action="/questions/<%= q.id %>/edit" method="POST">
                            <div class="mb-3 text-end">
                                <label class="form-label fw-bold"><%= __('Question_Text') || 'Question Text' %></label>
                                <textarea name="question_text" class="form-control" rows="8" style="direction: rtl; font-size: 1.3rem;"><%= q.question_text %></textarea>
                            </div>
                            <div class="row mb-3 text-start">
                                <div class="col-6">
                                    <label class="form-label fw-bold"><%= __('Marks') || 'Marks' %></label>
                                    <input type="number" name="marks" class="form-control" value="<%= q.marks %>">
                                </div>
                                <div class="col-6">
                                    <label class="form-label fw-bold"><%= __('Section') || 'Section / Hisa' %></label>
                                    <input type="text" name="section" class="form-control" value="<%= q.section %>" placeholder="مثلاً: حصہ الف">
                                </div>
                            </div>
                            <div class="text-end">
                                <button type="button" class="btn btn-secondary" onclick="toggleEdit('<%= q.id %>')"><%= __('Cancel') || 'Cancel' %></button>
                                <button type="submit" class="btn btn-success"><i class="bi bi-check-lg"></i> <%= __('Save_Changes') || 'Save Changes' %></button>
                            </div>
                        </form>
                    </div>
                </div>
            <% }) %>
        <% } else { %>
            <div class="text-center mt-5 no-print" dir="ltr">
                <div class="alert alert-info d-inline-block">
                    <i class="bi bi-info-circle"></i> No questions found for this paper.
                </div>
                <div class="mt-3">
                    <form action="/papers/<%= paper.id %>/generate-default" method="POST" id="generateDefaultForm">
                        <button type="button" class="btn btn-success btn-lg shadow-sm" onclick="generateDefaultQuestions()">
                            <i class="bi bi-magic"></i> Generate Default Paper Layout
                        </button>
                    </form>
                </div>
            </div>
        <% } %>
    </div>
</div>

<div class="container no-print mt-4 mb-5 text-center" style="max-width: 210mm;">
    <a href="javascript:history.back()" class="btn btn-outline-secondary btn-lg"><i class="bi bi-arrow-left"></i> <%= __('Back') || 'Back' %></a>
    <button onclick="window.print()" class="btn btn-outline-primary btn-lg ms-3"><i class="bi bi-printer"></i> <%= __('Print_Paper') || 'Print Paper' %></button>
</div>

<script>
    function toggleEdit(id) {
        const block = document.getElementById('question-' + id);
        block.classList.toggle('editing');
    }

    function generateDefaultQuestions() {
        const btn = document.querySelector('button[onclick="generateDefaultQuestions()"]');
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Generating...';

        const defaultQuestions = [
            "سوال 1 (حصہ الف) ________________________________________________\n\n...یا...\n\n(حصہ ب) ________________________________________________",
            "سوال 2 (حصہ الف) ________________________________________________\n\n...یا...\n\n(حصہ ب) ________________________________________________",
            "سوال 3 (حصہ الف) ________________________________________________\n\n...یا...\n\n(حصہ ب) ________________________________________________"
        ];

        // We will post these to the existing add question route one by one using fetch
        const promises = defaultQuestions.map((qText, idx) => {
            return fetch(`/papers/<%= paper.id %>/questions`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                },
                body: new URLSearchParams({
                    question_text: qText,
                    marks: 33,
                    section: ''
                })
            });
        });

        Promise.all(promises)
            .then(responses => {
                window.location.reload();
            })
            .catch(err => {
                console.error(err);
                alert("Error generating default layout.");
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-magic"></i> Generate Default Paper Layout';
            });
    }
</script>

<%- include('../partials/footer') %>
