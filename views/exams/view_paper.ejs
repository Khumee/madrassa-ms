<%- include('../partials/header', { title: __('View_Paper') || 'View Paper' }) %>

<style>
    body {
        background-color: #f8f9fa;
    }

    .paper-container {
        direction: rtl;
        text-align: right;
        background: #fff;
        width: 210mm;
        min-height: 297mm;
        margin: 20px auto;
        padding: 15mm 20mm;
        box-shadow: 0 0 15px rgba(0,0,0,0.1);
        position: relative;
        color: #000;
        line-height: 1.6;
    }

    .paper-header {
        position: relative;
        margin-bottom: 5px;
    }

    .bismillah {
        text-align: center;
        font-size: 1.1rem;
        margin-bottom: 0;
        line-height: 1;
    }

    .madrassa-name {
        font-size: 2.8rem;
        font-weight: bold;
        text-align: center;
        margin: 5px 0;
        line-height: 1;
    }

    .madrassa-logo {
        display: block;
        margin: 5px auto;
        width: 80px;
        height: auto;
    }

    .exam-title {
        font-weight: bold;
        text-align: center;
        font-size: 1.4rem;
        margin: 10px 0;
    }

    .paper-meta {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        font-size: 1.2rem;
        font-weight: bold;
        margin-top: -60px; /* Bring it up alongside the center logo */
        position: relative;
        z-index: 10;
    }

    .meta-right {
        text-align: right;
    }

    .meta-left {
        text-align: left;
    }

    .thick-line {
        border-top: 3px solid #000;
        border-bottom: 1px solid #000;
        height: 6px;
        background: transparent;
        margin: 10px 0;
        opacity: 1;
    }

    .note-section {
        text-align: center;
        font-size: 1.1rem;
        font-weight: bold;
        margin-bottom: 15px;
    }
    
    .note-section p {
        margin-bottom: 5px;
    }

    .subject-title {
        font-size: 1.3rem;
        font-weight: bold;
        text-decoration: underline;
        text-align: center;
    }

    .question-block {
        margin-bottom: 25px;
        position: relative;
        font-size: 1.2rem;
    }

    .question-actions {
        position: absolute;
        top: -10px;
        left: -10px;
        opacity: 0.2;
        transition: opacity 0.2s;
        z-index: 100;
    }

    .question-block:hover .question-actions {
        opacity: 1;
    }

    .question-text-view {
        white-space: pre-wrap;
        display: inline-block;
        width: 100%;
        line-height: 1.8;
    }

    .empty-lines {
        margin-top: 15px;
        border-bottom: 1px dashed #777;
        height: 35px;
        width: 100%;
    }

    .edit-mode {
        display: none;
    }

    .question-block.editing .view-mode {
        display: none;
    }

    .question-block.editing .edit-mode {
        display: block;
    }

    .question-block.editing .question-actions {
        display: none;
    }

    .print-only {
        display: none;
    }

    @media print {
        body {
            background: #fff;
            margin: 0;
            padding: 0;
        }
        .container, .navbar, .footer, .btn, .question-actions, .no-print {
            display: none !important;
        }
        .paper-container {
            margin: 0;
            padding: 0;
            box-shadow: none;
            width: 100%;
            min-height: auto;
            border: none;
        }
        .print-only {
            display: block;
        }
        @page {
            size: A4;
            margin: 15mm;
        }
    }
</style>

<div class="container no-print mt-2 text-end" style="max-width: 210mm;">
    <a href="javascript:history.back()" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i> <%= __('Back') || 'Back' %></a>
    <button onclick="window.print()" class="btn btn-outline-primary btn-sm ms-2"><i class="bi bi-printer"></i> <%= __('Print_Paper') || 'Print Paper' %></button>
</div>

<div class="paper-container">
    <!-- Header aligned with the provided image -->
    <div class="paper-header">
        <p class="bismillah">بسم الله الرحمن الرحيم</p>
        <h1 class="madrassa-name">کلیۃ العلوم الاسلامیہ</h1>
        <!-- Using a placeholder logo or standard logo.png -->
        <img src="/images/logo.png" alt="Logo" class="madrassa-logo" onerror="this.src='https://via.placeholder.com/80x80?text=Logo'">
        
        <div class="paper-meta">
            <div class="meta-right">
                <span class="d-block">مجموع الدرجات ١٠٠</span>
            </div>
            <div class="meta-left" dir="ltr">
                <span class="d-block text-end" style="font-family: sans-serif; font-size: 1rem;">Date: <%= new Date().toLocaleDateString('ur-PK') %></span>
                <span class="d-block text-end">الوقت ٣ ساعات</span>
            </div>
        </div>
        
        <h3 class="exam-title">الاختبار السنوي  [<%= paper.class_name %>]</h3>
    </div>
    
    <div class="thick-line"></div>
    
    <div class="note-section">
        <p>ملحوظة: ہر سوال کے دو حصوں (الف اور ب) میں سے کسی ایک کا جواب لکھیں۔ صحیح عربی میں پرچہ حل کرنے پر انشاء عربی کے پانچ نمبر ہوں گے۔</p>
        <div class="subject-title">الورقة في مادة (<%= paper.subject %>) - المعلم: <%= paper.teacher_name %></div>
    </div>

    <!-- Questions Area -->
    <div id="questions-area">
        <% if (questions && questions.length > 0) { %>
            <% questions.forEach((q, index) => { %>
                <div class="question-block" id="question-<%= q.id %>">
                    <!-- Actions (Hidden in Print) -->
                    <div class="question-actions no-print">
                        <button class="btn btn-sm btn-primary" onclick="toggleEdit('<%= q.id %>')" title="Edit"><i class="bi bi-pencil"></i></button>
                        <form action="/questions/<%= q.id %>/delete" method="POST" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this question?');">
                            <button type="submit" class="btn btn-sm btn-danger"><i class="bi bi-trash"></i></button>
                        </form>
                    </div>

                    <!-- View Mode -->
                    <div class="view-mode">
                        <div class="question-text-view"><strong>السؤال <%= index + 1 %>:</strong> <%= q.question_text %></div>
                        
                        <!-- Empty lines for answers (3-4 lines as requested) -->
                        <div class="empty-lines"></div>
                        <div class="empty-lines"></div>
                        <div class="empty-lines"></div>
                        <div class="empty-lines"></div>
                    </div>

                    <!-- Edit Mode -->
                    <div class="edit-mode no-print mt-3 p-3 border rounded bg-light" dir="ltr">
                        <form action="/questions/<%= q.id %>/edit" method="POST">
                            <div class="mb-3 text-end">
                                <label class="form-label fw-bold">Question Text</label>
                                <textarea name="question_text" class="form-control" rows="8" style="direction: rtl; font-size: 1.3rem;"><%= q.question_text %></textarea>
                            </div>
                            <div class="row mb-3 text-start">
                                <div class="col-6">
                                    <label class="form-label fw-bold">Marks</label>
                                    <input type="number" name="marks" class="form-control" value="<%= q.marks %>">
                                </div>
                                <div class="col-6">
                                    <label class="form-label fw-bold">Section / Hisa (حصہ)</label>
                                    <input type="text" name="section" class="form-control" value="<%= q.section %>" placeholder="مثلاً: حصہ الف">
                                </div>
                            </div>
                            <div class="text-end">
                                <button type="button" class="btn btn-secondary" onclick="toggleEdit('<%= q.id %>')"><%= __('Cancel') || 'Cancel' %></button>
                                <button type="submit" class="btn btn-success"><i class="bi bi-check-lg"></i> <%= __('Save_Changes') || 'Save Changes' %></button>
                            </div>
                        </form>
                    </div>
                </div>
            <% }) %>
        <% } else { %>
            <div class="text-center mt-5 no-print" dir="ltr">
                <div class="alert alert-info d-inline-block">
                    <i class="bi bi-info-circle"></i> No questions found for this paper.
                </div>
                <div class="mt-3">
                    <form action="/papers/<%= paper.id %>/generate-default" method="POST" id="generateDefaultForm">
                        <button type="button" class="btn btn-success btn-lg shadow-sm" onclick="generateDefaultQuestions()">
                            <i class="bi bi-magic"></i> Generate Default Paper Layout
                        </button>
                    </form>
                </div>
            </div>
        <% } %>
    </div>
    
    <!-- Add new question inline form -->
    <div class="no-print mt-5 border pt-4 px-4 pb-3 rounded bg-light" dir="ltr">
        <h5 class="fw-bold mb-3"><i class="bi bi-plus-circle"></i> Add New Question</h5>
        <form action="/papers/<%= paper.id %>/questions" method="POST">
            <div class="mb-3 text-end">
                <textarea name="question_text" class="form-control shadow-sm" rows="4" placeholder="(حصہ الف)..." style="direction: rtl; font-size: 1.3rem;" required></textarea>
            </div>
            <div class="row mb-3 align-items-end text-start">
                <div class="col-md-4">
                    <label class="form-label">Marks</label>
                    <input type="number" name="marks" class="form-control" value="10" required>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Section / Hisa (حصہ)</label>
                    <input type="text" name="section" class="form-control" placeholder="مثلاً: حصہ الف">
                </div>
                <div class="col-md-4">
                    <button type="submit" class="btn btn-primary w-100"><i class="bi bi-plus-lg"></i> <%= __('Add_Question') || 'Add Question' %></button>
                </div>
            </div>
        </form>
    </div>
</div>

<script>
    function toggleEdit(id) {
        const block = document.getElementById('question-' + id);
        block.classList.toggle('editing');
    }

    function generateDefaultQuestions() {
        const btn = document.querySelector('button[onclick="generateDefaultQuestions()"]');
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Generating...';

        const defaultQuestions = [
            "(حصہ الف) ________________________________________________\n\n...یا...\n\n(حصہ ب) ________________________________________________",
            "(حصہ الف) ________________________________________________\n\n...یا...\n\n(حصہ ب) ________________________________________________",
            "(حصہ الف) ________________________________________________\n\n...یا...\n\n(حصہ ب) ________________________________________________"
        ];

        // We will post these to the existing add question route one by one using fetch
        const promises = defaultQuestions.map((qText, idx) => {
            return fetch(`/papers/<%= paper.id %>/questions`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                },
                body: new URLSearchParams({
                    question_text: qText,
                    marks: 33,
                    section: ''
                })
            });
        });

        Promise.all(promises)
            .then(responses => {
                window.location.reload();
            })
            .catch(err => {
                console.error(err);
                alert("Error generating default layout.");
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-magic"></i> Generate Default Paper Layout';
            });
    }
</script>

<%- include('../partials/footer') %>
