<%- include('../partials/header', { title: __('View_Paper') || 'View Paper' }) %>

<style>
    body {
        background-color: #f8f9fa;
    }

    .paper-container {
        direction: rtl;
        text-align: right;
        background: #fff;
        width: 210mm;
        min-height: 297mm;
        margin: 20px auto;
        padding: 15mm 20mm;
        box-shadow: 0 0 15px rgba(0,0,0,0.1);
        position: relative;
        color: #000;
        line-height: 1.6;
    }

    .thick-line {
        border-top: 3px solid #000;
        border-bottom: 1px solid #000;
        height: 6px;
        background: transparent;
        margin: 10px 0;
        opacity: 1;
    }

    .note-section {
        text-align: center;
        font-size: 0.9rem;
        font-weight: bold;
        margin-bottom: 15px;
    }
    
    .note-section p {
        margin-bottom: 5px;
    }

    .subject-title {
        font-size: 1rem;
        font-weight: bold;
        text-decoration: underline;
        text-align: center;
    }

    .question-block {
        margin-bottom: 25px;
        font-size: 1.2rem;
    }

    .question-actions {
        opacity: 0.2;
        transition: opacity 0.2s;
    }

    .question-block:hover .question-actions {
        opacity: 1;
    }

    .question-text-view {
        white-space: pre-wrap;
        display: inline-block;
        width: 100%;
        line-height: 1.8;
    }

    .empty-lines {
        margin-top: 15px;
        border-bottom: 1px dashed #777;
        height: 35px;
        width: 100%;
    }

    .edit-mode {
        display: none;
    }

    .question-block.editing .view-mode {
        display: none;
    }

    .question-block.editing .edit-mode {
        display: block;
    }

    .question-block.editing .question-actions {
        display: none;
    }

    .print-only {
        display: none;
    }

    @media print {
        body {
            background: #fff;
            margin: 0;
            padding: 0;
        }
        .container, .navbar, .footer, .btn, .question-actions, .no-print {
            display: none !important;
        }
        .paper-container {
            margin: 0;
            padding: 0;
            box-shadow: none;
            width: 100%;
            min-height: auto;
            border: none;
        }
        .print-only {
            display: block;
        }
        @page {
            size: A4;
            margin: 15mm;
        }
    }
</style>

<div class="paper-container">
    <!-- Compact Header (Under 1 inch) -->
    <div class="d-flex justify-content-between align-items-center" style="margin-bottom: 5px; min-height: 50px;">
        <!-- Right side (Logo and Marks) -->
        <div class="d-flex align-items-center text-end">
            <img src="/logo.jpg" alt="Logo" style="height: 50px; margin-left: 10px;" onerror="this.style.display='none'">
            <div style="font-size: 1rem;">
                <% 
                    let calculatedTotal = 0;
                    if (questions && questions.length > 0) {
                        for (let i = 0; i < questions.length; i += 2) {
                            let m1 = Number(questions[i].marks || 0);
                            let m2 = (i + 1 < questions.length) ? Number(questions[i+1].marks || 0) : 0;
                            calculatedTotal += Math.max(m1, m2);
                        }
                    } else {
                        calculatedTotal = paper.max_marks || 100;
                    }
                    const urduDigits = ['٠', '١', '٢', '٣', '٤', '٥', '٦', '٧', '٨', '٩'];
                    let urduTotal = String(calculatedTotal).replace(/[0-9]/g, d => urduDigits[d]);
                %>
                <span class="d-block fw-bold">مجموع الدرجات <%= urduTotal %></span>
            </div>
        </div>
        
        <!-- Center (Title) -->
        <div class="text-center">
            <p class="mb-0" style="font-size: 0.8rem;">بسم الله الرحمن الرحيم</p>
            <h4 class="fw-bold mb-0" style="font-size: 1.5rem;">کلیۃ العلوم الاسلامیہ</h4>
            <div class="fw-bold" style="font-size: 1.1rem;">الاختبار السنوي  [<%= paper.class_name %>]</div>
        </div>
        
        <!-- Left side (Time/Date) -->
        <div class="text-start" style="font-size: 1rem;">
            <span class="d-block fw-bold">تاریخ: <%= new Date().toLocaleDateString('ur-PK') %></span>
            <span class="d-block fw-bold">الوقت ٣ ساعات</span>
        </div>
    </div>
    
    <div class="thick-line"></div>
    
    <div class="note-section">
        <p>ملحوظة: ہر سوال کے دو حصوں (الف اور ب) میں سے کسی ایک کا جواب لکھیں۔ صحیح عربی میں پرچہ حل کرنے پر انشاء عربی کے پانچ نمبر ہوں گے۔</p>
        <div class="subject-title">الورقة في مادة (<%= paper.subject %>) - المعلم: <%= paper.teacher_name %></div>
    </div>

    <!-- Questions Area -->
    <div id="questions-area">
        <% if (questions && questions.length > 0) { %>
            <% questions.forEach((q, index) => { %>
                
                <% if (index > 0 && index % 2 !== 0) { %>
                    <div class="text-center fw-bold my-2 fs-5">...یا...</div>
                <% } %>
                
                <% 
                    let questionNum = Math.floor(index / 2) + 1;
                    let partName = (index % 2 === 0) ? 'الف' : 'ب';
                    let label = `سوال ${questionNum} (حصہ ${partName})`;
                    const urduDigitsLocal = ['٠', '١', '٢', '٣', '٤', '٥', '٦', '٧', '٨', '٩'];
                    let qMarksUrdu = String(q.marks || 0).replace(/[0-9]/g, d => urduDigitsLocal[d]);
                %>

                <div class="question-block" id="question-<%= q.id %>">
                    <!-- View Mode -->
                    <div class="view-mode">
                        <div class="question-text-view"><strong class="me-2"><%= label %>:</strong> <%= q.question_text ? q.question_text.trim() : '' %> <span class="ms-1">(<%= qMarksUrdu %>)</span></div>
                        
                        <!-- Empty lines for answers -->
                        <% if (!q.question_text || q.question_text.trim() === '') { %>
                            <div class="empty-lines"></div>
                            <div class="empty-lines"></div>
                            <div class="empty-lines"></div>
                            <div class="empty-lines"></div>
                        <% } %>
                        
                        <!-- Actions (Hidden in Print) -->
                        <div class="question-actions no-print text-end mt-2">
                            <button class="btn btn-sm btn-primary px-3" onclick="toggleEdit('<%= q.id %>')" title="ترمیم کریں"><i class="bi bi-pencil"></i> ترمیم کریں</button>
                        </div>
                    </div>

                    <!-- Edit Mode -->
                    <div class="edit-mode no-print mt-3 p-3 border rounded bg-light" dir="ltr">
                        <form action="/questions/<%= q.id %>/edit" method="POST">
                            <div class="mb-3 text-end" dir="rtl">
                                <label class="form-label fw-bold"><strong class="me-2 text-primary"><%= label %>:</strong> <%= __('Question_Text') || 'Question Text' %></label>
                                <textarea name="question_text" class="form-control" rows="4" style="direction: rtl; font-size: 1.3rem;" placeholder="<%= __('Type_your_question_here') || 'اپنا سوال یہاں لکھیں...' %>"><%= q.question_text %></textarea>
                            </div>
                            <div class="row mb-3 text-start">
                                <div class="col-6">
                                    <label class="form-label fw-bold"><%= __('Marks') || 'Marks' %></label>
                                    <input type="number" name="marks" class="form-control" value="<%= q.marks %>">
                                </div>
                                <div class="col-6">
                                    <label class="form-label fw-bold"><%= __('Section') || 'Section / Hisa' %></label>
                                    <input type="text" name="section" class="form-control" value="<%= q.section %>" placeholder="مثلاً: حصہ الف">
                                </div>
                            </div>
                            <div class="text-end">
                                <button type="button" class="btn btn-secondary" onclick="toggleEdit('<%= q.id %>')"><%= __('Cancel') || 'Cancel' %></button>
                                <button type="submit" class="btn btn-success"><i class="bi bi-check-lg"></i> <%= __('Save_Changes') || 'Save Changes' %></button>
                            </div>
                        </form>
                    </div>
                </div>
            <% }) %>
        <% } else { %>
            <div class="text-center mt-5 no-print" dir="ltr">
                <div class="alert alert-info d-inline-block">
                    <i class="bi bi-info-circle"></i> No questions found for this paper.
                </div>
                <div class="mt-3">
                    <form action="/papers/<%= paper.id %>/generate-default" method="POST" id="generateDefaultForm">
                        <button type="button" class="btn btn-success btn-lg shadow-sm" onclick="generateDefaultQuestions()">
                            <i class="bi bi-magic"></i> Generate Default Paper Layout
                        </button>
                    </form>
                </div>
            </div>
        <% } %>
    </div>
</div>

<div class="container no-print mt-4 mb-5 text-center" style="max-width: 210mm;">
    <a href="javascript:history.back()" class="btn btn-outline-secondary btn-lg"><i class="bi bi-arrow-left"></i> واپس</a>
    <button onclick="window.print()" class="btn btn-outline-primary btn-lg ms-3"><i class="bi bi-printer"></i> پرنٹ کریں</button>
</div>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const urlParams = new URLSearchParams(window.location.search);
        if (urlParams.get('print') === 'true') {
            setTimeout(() => { window.print(); }, 500);
        }
    });

    function toggleEdit(id) {
        const block = document.getElementById('question-' + id);
        block.classList.toggle('editing');
    }

    async function generateDefaultQuestions() {
        const btn = document.querySelector('button[onclick="generateDefaultQuestions()"]');
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Generating...';

        // Generate 6 empty questions (3 questions, 2 parts each)
        for (let i = 0; i < 6; i++) {
            let sectionName = (i % 2 === 0) ? 'الف' : 'ب';
            
            await fetch(`/papers/<%= paper.id %>/questions`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                },
                body: new URLSearchParams({
                    question_text: '',
                    marks: 10,
                    section: sectionName
                })
            });
        }
        
        window.location.reload();
    }
</script>

<%- include('../partials/footer') %>
