<%- include('../partials/header', { title: __('All_Papers') || 'All Papers' }) %>
<div class="container mt-4">
    <h2><%= __('All_Papers') || 'All Papers' %></h2>
    <div class="table-responsive">
        <table class="table table-bordered mt-3 table-striped">
            <thead class="table-dark">
                <tr>
                    <th><%= __('Exam') %></th>
                    <th><%= __('Class') %></th>
                    <th><%= __('Subject') %></th>
                    <th><%= __('Teacher') %></th>
                    <th><%= __('Max_Marks') %></th>
                    <th><%= __('Status') %></th>
                    <th><%= __('Actions') %></th>
                </tr>
            </thead>
            <tbody>
                <% if (papers && papers.length > 0) { %>
                    <% papers.forEach(p => { %>
                        <tr>
                            <td><%= p.exam_name %></td>
                            <td><%= p.class_name %></td>
                            <td><%= p.subject %></td>
                            <td><%= p.teacher_name %></td>
                            <td><%= p.max_marks %></td>
                            <td>
                                <span class="badge bg-<%= p.status === 'approved' ? 'success' : (p.status === 'submitted' ? 'info' : (p.status === 'rejected' ? 'danger' : 'secondary')) %>">
                                    <%= __(p.status) || p.status %>
                                </span>
                            </td>
                            <td>
                                <a href="/papers/<%= p.id %>/view" class="btn btn-sm btn-info text-white"><%= __('View_Paper') || 'View Paper' %></a>
                            </td>
                        </tr>
                    <% }) %>
                <% } else { %>
                    <tr>
                        <td colspan="7" class="text-center"><%= __('No_papers_found') || 'No papers found' %></td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</div>
<%- include('../partials/footer') %>
