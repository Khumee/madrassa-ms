<%- include('../partials/header', { title: __('Date_Sheet') || 'Date Sheet' }) %>

<!-- Print styling -->
<style>
    @media print {
        nav.navbar,
        #pdfLoaderOverlay,
        #toastContainer,
        #globalAlertDialog,
        #globalConfirmDialog,
        footer.text-center,
        .no-print {
            display: none !important;
        }
        body, .container.pb-5, .container.mt-4.mb-5 {
            margin: 0 !important;
            padding: 0 !important;
            max-width: 100% !important;
        }
        .card {
            border: none !important;
            box-shadow: none !important;
        }
        .datesheet-container {
            border: none !important;
            border-radius: 0 !important;
            max-width: 100% !important;
        }
        .datesheet-table,
        .datesheet-table th,
        .datesheet-table td {
            border: 1px solid #000 !important;
            border-collapse: collapse !important;
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
        }
        .datesheet-table thead th {
            background-color: #2c3e50 !important;
            color: #fff !important;
        }
        .datesheet-table .date-group-start td {
            border-top: 3px solid #2c3e50 !important;
        }
        @page {
            margin: 10mm;
        }
    }

    .datesheet-container {
        max-width: 900px;
        margin: auto;
        border: 2px solid #2c3e50;
        border-radius: 12px;
        background-color: #fff;
    }

    .watermark {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        opacity: 0.05;
        z-index: 0;
        width: 60%;
        pointer-events: none;
    }

    .datesheet-table th, .datesheet-table td {
        vertical-align: middle;
    }
</style>

<div class="container mt-4 mb-5">
    <div class="text-end mb-3 no-print">
        <a href="<%= (locals.session && ['مدير', 'ناظم'].includes(session.role)) ? '/exams/' + exam.id + '/papers' : '/' %>" class="btn btn-outline-secondary me-2"><i class="bi bi-arrow-left"></i> <%= __('Back') || 'واپس' %></a>
        <a href="/exams/<%= exam.id %>/datesheet/pdf" class="btn btn-success me-2"><i class="bi bi-file-earmark-pdf me-1"></i> <%= __('Download_PDF') || 'Download PDF' %></a>
        <button onclick="window.print()" class="btn btn-dark"><i class="bi bi-printer"></i> <%= __('Print') || 'پرنٹ' %></button>
    </div>

    <div class="card shadow-lg p-3 p-md-4 datesheet-container position-relative">
        <% if (locals.tenant && locals.tenant.logo_url) { %>
            <img src="<%= tenant.logo_url %>" alt="Madrassa Logo" class="watermark">
        <% } %>

        <!-- Header Section -->
        <div class="row mb-2 align-items-center" style="position: relative; z-index: 1;">
            <div class="col-3 text-center">
                <% if (locals.tenant && locals.tenant.logo_url) { %>
                    <img src="<%= tenant.logo_url %>" alt="Logo" style="max-height: 70px; max-width: 100%;">
                <% } %>
            </div>
            <div class="col-6 text-center">
                <h2 class="fw-bold text-dark mb-1" style="white-space: nowrap;"><%= locals.tenant ? (tenant.subdomain === 'madrassa-ms' ? __('Jamia_Habibullah_Islamabad') : (tenant.subdomain === 'kui' ? __('KUI_Production') : tenant.school_name)) : __('College_Name') %></h2>
                <h5 class="text-secondary mb-2"><%= exam.name %></h5>
                <h6 class="fw-bold bg-dark text-white d-inline-block px-3 py-1 rounded-pill mb-0"><%= __('Date_Sheet') || 'Date Sheet' %></h6>
            </div>
            <div class="col-3 text-center"></div>
        </div>

        <hr style="border-top: 2px solid #2c3e50; opacity: 1;" class="my-2">

        <!-- Date Sheet Table -->
        <div style="position: relative; z-index: 1;">
            <table class="table table-bordered table-sm text-center align-middle border-dark mb-2 datesheet-table">
                <thead class="table-dark">
                    <tr>
                        <th class="py-2"><%= __('Date') %></th>
                        <th class="py-2"><%= __('Day') %></th>
                        <th class="py-2"><%= __('Class') %></th>
                        <th class="py-2"><%= __('Subject') %></th>
                        <th class="py-2"><%= __('Teacher') %></th>
                    </tr>
                </thead>
                <tbody>
                    <% if (groups && groups.length > 0) { %>
                        <% groups.forEach((g, gIdx) => { %>
                            <% const dateLabel = g.date ? new Date(g.date).toLocaleDateString() : (__('Not_set') || '-'); %>
                            <% g.rows.forEach((p, rIdx) => { %>
                                <tr class="<%= (gIdx > 0 && rIdx === 0) ? 'date-group-start' : '' %>">
                                    <td class="fw-bold"><%= dateLabel %></td>
                                    <td class="fw-bold"><%= g.dayName || '-' %></td>
                                    <td><%= p.class_name %></td>
                                    <td class="text-start px-3"><%= p.subject %></td>
                                    <td><%= p.teacher_name %></td>
                                </tr>
                            <% }) %>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="5" class="text-center text-muted"><%= __('No_Papers_Found') || 'No papers found' %></td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>
<%- include('../partials/footer') %>
