<%- include('partials/header') %>

<div class="row mb-4">
    <div class="col-md-12">
        <div class="card shadow-sm border-0 rounded-4 p-4 text-white" style="background: linear-gradient(135deg, #4f46e5 0%, #3730a3 100%);">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                <div>
                    <h1 class="fw-bold mb-1">
                        <i class="bi bi-envelope-paper me-2"></i>
                        <%= __('Leave_Requests') || 'رخصت کی درخواستیں' %>
                    </h1>
                    <p class="text-indigo-100 mb-0">
                        <%= __('Leave_Requests_Sub') || 'طلباء کی جانب سے موصول ہونے والی رخصت کی درخواستیں دیکھیں اور فیصلہ کریں۔' %>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-12">
        <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="p-4"><%= __('Student') || 'طالب علم' %></th>
                                <th class="p-4"><%= __('Class') || 'کلاس' %></th>
                                <th class="p-4"><%= __('Start_Date') || 'شروع' %></th>
                                <th class="p-4"><%= __('End_Date') || 'ختم' %></th>
                                <th class="p-4"><%= __('Reason') || 'وجہ' %></th>
                                <th class="p-4"><%= __('Status') || 'حالت' %></th>
                                <th class="p-4 text-end"><%= __('Actions') || 'عمل' %></th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (leaves.length === 0) { %>
                                <tr>
                                    <td colspan="7" class="text-center py-5 text-muted">
                                        <i class="bi bi-inbox fs-1 d-block mb-3"></i>
                                        <%= __('No_Leave_Requests') || 'کوئی درخواست زیر التواء نہیں ہے' %>
                                    </td>
                                </tr>
                            <% } else { %>
                                <% leaves.forEach(leave => { %>
                                    <tr>
                                        <td class="p-4 fw-bold"><%= leave.student_name %></td>
                                        <td class="p-4"><%= leave.class_name || '-' %></td>
                                        <td class="p-4 text-nowrap"><%= new Date(leave.start_date).toLocaleDateString('ur-PK') %></td>
                                        <td class="p-4 text-nowrap"><%= new Date(leave.end_date).toLocaleDateString('ur-PK') %></td>
                                        <td class="p-4" style="max-width: 250px;"><%= leave.reason %></td>
                                        <td class="p-4">
                                            <% if (leave.status === 'pending') { %>
                                                <span class="badge bg-warning text-dark px-3 py-2 rounded-pill"><%= __('Pending') || 'زیر التواء' %></span>
                                            <% } else if (leave.status === 'approved') { %>
                                                <span class="badge bg-success px-3 py-2 rounded-pill"><%= __('Approved') || 'منظور شدہ' %></span>
                                            <% } else { %>
                                                <span class="badge bg-danger px-3 py-2 rounded-pill"><%= __('Rejected') || 'مسترد شدہ' %></span>
                                            <% } %>
                                        </td>
                                        <td class="p-4 text-end text-nowrap">
                                            <% if (leave.status === 'pending') { %>
                                                <form action="/leaves/approve/<%= leave.id %>" method="POST" class="d-inline">
                                                    <button type="submit" class="btn btn-success btn-sm rounded-pill px-3 me-2">
                                                        <i class="bi bi-check-circle me-1"></i><%= __('Approve') || 'منظور کریں' %>
                                                    </button>
                                                </form>
                                                <form action="/leaves/reject/<%= leave.id %>" method="POST" class="d-inline">
                                                    <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3 me-2">
                                                        <i class="bi bi-x-circle me-1"></i><%= __('Reject') || 'مسترد کریں' %>
                                                    </button>
                                                </form>
                                            <% } else { %>
                                                <span class="text-muted small me-2"><%= __('Action_Taken') || 'کارروائی مکمل ہو گئی' %></span>
                                            <% } %>
                                            <button type="button" class="btn btn-danger btn-sm rounded-pill px-3" title="Delete" data-bs-toggle="modal" data-bs-target="#deleteAdminModal<%= leave.id %>">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                            
                                            <!-- Delete Modal -->
                                            <div class="modal fade text-start" id="deleteAdminModal<%= leave.id %>" tabindex="-1">
                                                <div class="modal-dialog modal-dialog-centered">
                                                    <div class="modal-content border-0 rounded-4 shadow">
                                                        <div class="modal-header bg-danger text-white rounded-top-4">
                                                            <h5 class="modal-title"><i class="bi bi-exclamation-triangle me-2"></i><%= __('Confirm_Delete') || 'کیا آپ واقعی حذف کرنا چاہتے ہیں؟' %></h5>
                                                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                                        </div>
                                                        <div class="modal-body p-4 text-center text-dark text-wrap">
                                                            <p class="fs-5 mb-0"><%= __('Confirm_Delete') || 'کیا آپ واقعی حذف کرنا چاہتے ہیں؟' %></p>
                                                        </div>
                                                        <div class="modal-footer border-0 pb-4 justify-content-center">
                                                            <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal"><%= __('Cancel') || 'منسوخ کریں' %></button>
                                                            <form action="/leaves/delete/<%= leave.id %>" method="POST" class="d-inline">
                                                                <button type="submit" class="btn btn-danger rounded-pill px-4"><%= __('Delete') || 'حذف کریں' %></button>
                                                            </form>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .text-indigo-100 {
        color: #e0e7ff;
    }
</style>

<%- include('partials/footer') %>
