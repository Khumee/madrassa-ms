<%- include('partials/header') %>

<div class="row mb-4 align-items-center no-print">
    <div class="col-md-8">
        <h1 class="fw-bold text-primary mb-0"><%= __('Reports_Stats_Title') %> - <%= locals.lang === 'ur' ? 'مکمل سیشن رپورٹ' : 'تقرير الجلسة الكاملة' %></h1>
        <p class="text-muted"><%= __('Start_Date') %>: <span class="badge bg-light text-primary border"><%= startDate %></span> <%= __('End_Date') %>: <span class="badge bg-light text-primary border"><%= endDate %></span></p>
    </div>
    <div class="col-md-4 text-end">
        <button onclick="downloadSessionPDF()" class="btn btn-danger rounded-pill px-4 shadow-sm fw-bold me-2">
            <i class="bi bi-file-earmark-pdf-fill me-2"></i><%= locals.lang === 'ur' ? 'PDF ڈاؤن لوڈ کریں' : 'تحميل PDF' %>
        </button>
        <a href="/reports" class="btn btn-outline-secondary rounded-pill px-4 shadow-sm fw-bold">
            <i class="bi bi-arrow-left me-2"></i><%= locals.lang === 'ur' ? 'واپس جائیں' : 'العودة' %>
        </a>
    </div>
</div>

<script>
function downloadSessionPDF() {
    if (typeof showPdfLoader === 'function') showPdfLoader();
    window.location.href = '/reports/session/pdf';
}
</script>

<style>
    @import url('https://fonts.googleapis.com/css2?family=Noto+Nastaliq+Urdu:wght@400;700&display=swap');

    /* Print-specific Header - Hidden on screen */
    .print-only-header { display: none; }

    @media print {
        .no-print, nav, #toastContainer, footer, .btn, .btn-group, .input-group, .filter-trigger-btn { display: none !important; }
        .collapse { display: block !important; height: auto !important; visibility: visible !important; }
        .print-only-header { 
            display: flex !important; 
            align-items: center; 
            justify-content: center;
            border-bottom: 2px solid #198754; 
            padding-bottom: 1rem; 
            margin-bottom: 2rem;
        }
        body { 
            background: white !important; 
            margin: 0 !important; 
            padding: 1.5cm !important; 
            /* Best fonts for Urdu/Arabic shaping in headless PDF generation */
            font-family: 'Jameel Noori Nastaleeq', 'Nafees Web Naskh', 'Amiri', 'Tahoma', 'Arial', sans-serif !important;
            color: #333 !important;
        }
        .card { 
            border: 1px solid #dee2e6 !important; 
            box-shadow: none !important; 
            margin-bottom: 2rem !important; 
            page-break-inside: avoid;
        }
        .card-header {
            background-color: #f8fafc !important;
            border-bottom: 1px solid #dee2e6 !important;
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
        }
        .accordion-button::after { display: none !important; }
        .accordion-button { 
            background-color: #f8fafc !important; 
            color: #1e293b !important; 
            border-bottom: 1px solid #eee !important;
        }
        
        /* Force page breaks after each class card */
        .book-class-card, .student-class-card {
            page-break-after: always;
            break-after: page;
            break-inside: avoid;
        }
        
        /* Ensure table rows do not break across pages if possible */
        tr { page-break-inside: avoid; break-inside: avoid; }
        .progress { border: 1px solid #ccc !important; }
        .progress-bar { -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important; }
    }
</style>

<!-- Print Header -->
<div class="print-only-header w-100 text-center flex-column gap-2 no-print">
    <div class="d-flex align-items-center justify-content-center gap-4">
        <img src="/logo.jpg" alt="Logo" style="width: 80px; height: 80px; object-fit: contain; border-radius: 50%;">
        <div>
            <h1 class="fw-bold mb-1" style="color: #198754;"><%= tenant && tenant.name ? tenant.name : (locals.lang === 'ur' ? 'مدرسہ انتظامی نظام' : 'Madrassa System') %></h1>
            <h3 class="fw-bold text-dark mb-0"><%= locals.lang === 'ur' ? 'مکمل سیشن رپورٹ' : 'تقرير الجلسة الكاملة' %></h3>
        </div>
    </div>
    <div class="text-muted mt-2" style="font-size: 1.1rem;">
        <%= __('Start_Date') %>: <strong><%= startDate %></strong> | <%= __('End_Date') %>: <strong><%= endDate %></strong>
    </div>
</div>

<!-- Teacher Book Progress Section (Top) -->
<div class="row mb-5">
    <div class="col-md-12">
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-header bg-white p-4 border-0 d-flex justify-content-between align-items-center flex-wrap gap-3">
                <div>
                    <h3 class="fw-bold mb-0 text-success"><%= __('Book_Completion_Report') %> - <%= locals.lang === 'ur' ? 'سیشن' : 'جلسة' %></h3>
                    <p class="text-muted mb-0 small"><%= locals.lang === 'ur' ? 'موجودہ سیشن — اب تک کی مکمل پیشرفت' : 'الجلسة الحالية — التقدم الإجمالي حتى الآن' %></p>
                </div>
            </div>
            
            <div class="card-body p-4">
                <div class="accordion accordion-flush" id="bookProgressAccordion">
                    <% Object.keys(groupedTeacherProgress).forEach((className, index) => { 
                        const progressList = groupedTeacherProgress[className];
                        const avg = Math.round(progressList.reduce((acc, p) => acc + p.percentage, 0) / (progressList.length || 1));
                    %>
                        <div class="accordion-item border rounded-4 mb-3 overflow-hidden book-class-card" data-class-name="<%= className %>">
                            <h2 class="accordion-header">
                                <button class="accordion-button collapsed p-4 bg-light" type="button" data-bs-toggle="collapse" data-bs-target="#book_collapse_<%= index %>">
                                    <div class="d-flex justify-content-between align-items-center w-100 me-3">
                                        <span class="fw-bold text-dark fs-5"><%= className %></span>
                                        <div class="d-flex gap-3 text-muted small">
                                            <span class="badge bg-white border text-primary rounded-pill px-3"><%= progressList.length %> <%= __('Books') %></span>
                                            <span class="badge bg-white border text-success rounded-pill px-3"><%= __('Average_Progress') || 'Average Progress' %> <%= avg %>%</span>
                                        </div>
                                    </div>
                                </button>
                            </h2>
                            <div id="book_collapse_<%= index %>" class="accordion-collapse collapse" data-bs-parent="#bookProgressAccordion">
                                <div class="accordion-body p-0">
                                    <div class="table-responsive">
                                        <table class="table table-hover align-middle mb-0 text-end">
                                            <thead class="table-light">
                                                <tr>
                                                    <th class="px-4"><%= __('Teacher') %></th>
                                                    <th><%= __('Book') %></th>
                                                    <th><%= __('Progress') %></th>
                                                    <th class="px-4 text-center"><%= __('Action') %></th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <% progressList.forEach(tp => { %>
                                                    <tr class="teacher-book-row" data-teacher="<%= tp.teacher_name.toLowerCase() %>" data-book="<%= tp.book_title.toLowerCase() %>">
                                                        <td class="px-4 fw-bold">
                                                            <a href="/reports/teacher/<%= tp.teacher_id %>" class="text-decoration-none text-success hover-underline">
                                                                <i class="bi bi-person-fill me-1"></i><%= tp.teacher_name %>
                                                            </a>
                                                        </td>
                                                        <td><%= tp.book_title %></td>
                                                        <td>
                                                            <div class="d-flex align-items-center gap-2 mb-1">
                                                                <div class="progress flex-grow-1" style="height: 8px; width: 100px;">
                                                                    <div class="progress-bar bg-success" role="progressbar" style="width: <%= tp.percentage %>%"></div>
                                                                </div>
                                                                <span class="small text-muted">ص <%= tp.current_page %> (<%= tp.percentage %>%)</span>
                                                            </div>
                                                            <% if (tp.last_updated_at) { %>
                                                                <small class="text-muted d-block" style="font-size: 0.72rem;">
                                                                    <i class="bi bi-clock-history me-1"></i><%= __('Last_Updated') %>: <%= tp.lastUpdatedStr %>
                                                                </small>
                                                            <% } else { %>
                                                                <small class="text-muted d-block" style="font-size: 0.72rem;">
                                                                    <%= __('No_Updates_Yet') %>
                                                                </small>
                                                            <% } %>
                                                        </td>
                                                        <td class="px-4 text-center">
                                                            <div class="d-flex justify-content-center gap-2">
                                                                <a href="/reports/teacher/<%= tp.teacher_id %>?book=<%= encodeURIComponent(tp.book_title) %>" class="btn btn-sm btn-outline-success rounded-pill px-3">
                                                                    <i class="bi bi-graph-up me-1"></i><%= __('Chart') %>
                                                                </a>
                                                            </div>
                                                        </td>
                                                    </tr>
                                                <% }) %>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Student Attendance Section -->
<div class="row mb-5">
    <div class="col-md-12">
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-header bg-white p-4 border-0 d-flex justify-content-between align-items-center flex-wrap gap-3">
                <h3 class="fw-bold mb-0 text-primary"><%= __('Student_Attendance_By_Class') %> - <%= locals.lang === 'ur' ? 'سیشن' : 'جلسة' %></h3>
            </div>
            
            <div class="card-body p-4">
                <div class="accordion accordion-flush" id="attendanceAccordion">
                    <% Object.keys(groupedReport).forEach((className, index) => { 
                        const students = groupedReport[className];
                        const avg = Math.round(students.reduce((acc, s) => acc + s.percentage, 0) / (students.length || 1));
                    %>
                        <div class="accordion-item border rounded-4 mb-3 overflow-hidden student-class-card" data-class-name="<%= className %>">
                            <h2 class="accordion-header">
                                <button class="accordion-button collapsed p-4 bg-light" type="button" data-bs-toggle="collapse" data-bs-target="#collapse_<%= index %>">
                                    <div class="d-flex justify-content-between align-items-center w-100 me-3">
                                        <span class="fw-bold text-dark fs-5"><%= className %></span>
                                        <div class="d-flex gap-3 text-muted small">
                                            <span class="badge bg-white border text-primary rounded-pill px-3"><%= students.length %> <%= __('Students') %></span>
                                            <span class="badge bg-white border text-success rounded-pill px-3"><%= __('Average_Attendance') %> <%= avg %>%</span>
                                        </div>
                                    </div>
                                </button>
                            </h2>
                            <div id="collapse_<%= index %>" class="accordion-collapse collapse" data-bs-parent="#attendanceAccordion">
                                <div class="accordion-body p-0">
                                    <div class="table-responsive">
                                        <table class="table table-hover align-middle mb-0 text-end">
                                            <thead class="table-light">
                                                <tr>
                                                    <th class="px-4"><%= __('Student_Name') %></th>
                                                    <th><%= __('Total_Days') %></th>
                                                    <th><%= __('Present_Days') %></th>
                                                    <th class="px-4 text-center"><%= __('Percentage') %></th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <% students.forEach(student => { %>
                                                    <tr class="student-row" data-name="<%= student.name.toLowerCase() %>">
                                                        <td class="px-4"><%= student.name %></td>
                                                        <td><%= student.total_days %></td>
                                                        <td><%= student.present_days %></td>
                                                        <td class="px-4 text-center">
                                                            <div class="d-flex align-items-center justify-content-center gap-2">
                                                                <div class="progress flex-grow-1" style="height: 8px; width: 100px;">
                                                                    <div class="progress-bar bg-<%= student.percentage >= 80 ? 'success' : 'danger' %>" 
                                                                         role="progressbar" style="width: <%= student.percentage %>%"></div>
                                                                </div>
                                                                <span class="fw-bold"><%= student.percentage %>%</span>
                                                            </div>
                                                        </td>
                                                    </tr>
                                                <% }) %>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('partials/footer') %>
